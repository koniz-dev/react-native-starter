{
  "name": "react-native-starter",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start -a",
    "ios": "expo start -i",
    "web": "expo start --web",
    "start:preview": "APP_VARIANT=preview EXPO_PUBLIC_APP_ENV=preview expo start",
    "start:production": "APP_VARIANT=production EXPO_PUBLIC_APP_ENV=production expo start --no-dev --minify",
    "prebuild:development": "APP_VARIANT=development expo prebuild --clean",
    "prebuild:preview": "APP_VARIANT=preview expo prebuild --clean",
    "prebuild:production": "APP_VARIANT=production expo prebuild --clean",
    "build:preview:android": "APP_VARIANT=preview EXPO_PUBLIC_APP_ENV=preview expo run:android --variant release",
    "build:preview:ios": "APP_VARIANT=preview EXPO_PUBLIC_APP_ENV=preview expo run:ios --configuration Release",
    "build:production:android": "APP_VARIANT=production EXPO_PUBLIC_APP_ENV=production expo run:android --variant release",
    "build:production:ios": "APP_VARIANT=production EXPO_PUBLIC_APP_ENV=production expo run:ios --configuration Release",
    "export:web": "APP_VARIANT=production EXPO_PUBLIC_APP_ENV=production expo export --platform web",
    "config:print": "expo config --type public",
    "init-project": "node scripts/init-project.js",
    "remove-demo": "node scripts/remove-demo.js",
    "new-feature": "node scripts/new-feature.js",
    "docs:check": "node scripts/check-docs.js",
    "audit:check": "node scripts/check-audit.js",
    "doctor": "EXPO_OFFLINE=1 npm_config_loglevel=notice expo-doctor",
    "test:e2e:android": "bash scripts/e2e/run.sh android",
    "test:e2e:ios": "bash scripts/e2e/run.sh ios",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "jest --watchAll",
    "test:ci": "jest --coverage",
    "test:coverage": "jest --coverage --coverageReporters=html --coverageReporters=text"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.20.0",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "~24.10.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-doctor": "1.20.4",
    "globals": "^16.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "prettier": "^3.6.2",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "clearMocks": true,
    "restoreMocks": true,
    "setupFiles": [
      "<rootDir>/jest.setup.env.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "features/**/*.{ts,tsx}",
      "shared/**/*.{ts,tsx}",
      "!**/*.d.ts"
    ],
    "coverageThreshold": {
      "./app/": {
        "statements": 95,
        "branches": 85,
        "functions": 80,
        "lines": 95
      },
      "./features/": {
        "statements": 95,
        "branches": 85,
        "functions": 90,
        "lines": 95
      },
      "./shared/": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      },
      "./{app,features,shared}/**/*.{ts,tsx}": {
        "statements": 70,
        "functions": 50,
        "lines": 70
      }
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|standard-navigation)"
    ]
  },
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "private": true
}
