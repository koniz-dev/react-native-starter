+import { renderRouter, screen } from 'expo-router/testing-library';
+import {
+  createMemoryAnalytics,
+  type MemoryAnalytics,
+} from '@/shared/integrations/adapters/memoryAnalytics';
+import { getAnalytics } from '@/shared/integrations/analytics';
+import { configureIntegrations } from '@/shared/integrations/setup';
+import { logger } from '@/shared/lib/logger';
+
+describe('createMemoryAnalytics', () => {
+  it('records every call in order and logs it', () => {
+    const debug = jest.spyOn(logger, 'debug').mockImplementation(() => {});
+    const analytics = createMemoryAnalytics();
+
+    analytics.screen('/notes');
+    analytics.track('notes_loaded', { count: 3 });
+    analytics.identify('u_1');
+    analytics.identify(null);
+
+    expect(analytics.records).toEqual([
+      { type: 'screen', name: '/notes', properties: undefined },
+      { type: 'track', name: 'notes_loaded', properties: { count: 3 } },
+      { type: 'identify', userId: 'u_1', traits: undefined },
+      { type: 'identify', userId: null, traits: undefined },
+    ]);
+    expect(debug).toHaveBeenCalledWith('[analytics] track', {
+      type: 'track',
+      name: 'notes_loaded',
+      properties: { count: 3 },
+    });
+    debug.mockRestore();
+  });
+
+  it('keeps only the newest records up to the limit, and clears', () => {
+    const analytics = createMemoryAnalytics(2);
+
+    analytics.track('a');
+    analytics.track('b');
+    analytics.track('c');
+    expect(analytics.records.map(r => r.type === 'track' && r.name)).toEqual([
+      'b',
+      'c',
+    ]);
+
+    analytics.clear();
+    expect(analytics.records).toEqual([]);
+  });
+});
+
+describe('configureIntegrations', () => {
+  it('registers the memory analytics provider, which records screen views', async () => {
+    configureIntegrations();
+    const analytics = getAnalytics() as MemoryAnalytics;
+
+    renderRouter('./app', { initialUrl: '/notes' });
+    await screen.findByText('Sign in to see your notes');
+
+    expect(analytics.records).toContainEqual({
+      type: 'screen',
+      name: '/notes',
+      properties: undefined,
+    });
+  });
+});
