+# The Notes tab, signed out, asks the user to sign in and opens Login. The
+# flows don't sign in (see scripts/e2e/run.sh), so the list itself is covered
+# by __tests__/features/notes/.
+appId: ${APP_ID}
+name: Notes tab asks a signed-out user to sign in
+---
+- runFlow:
+    file: subflows/open-app.yaml
+    env:
+      CLEAR_STATE: 'true'
+- waitForAnimationToEnd
+- tapOn:
+    id: tab-notes
+- extendedWaitUntil:
+    visible: Sign in to see your notes
+    timeout: 10000
+- takeScreenshot: 02-notes-signed-out
+- tapOn:
+    id: notes-sign-in
+- extendedWaitUntil:
+    visible: Welcome Back
+    timeout: 20000
