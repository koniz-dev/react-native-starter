+#!/usr/bin/env node
+/**
+ * Local mock of the Site Notes backend, for development only (the app never
+ * imports it). Point EXPO_PUBLIC_API_URL and EXPO_PUBLIC_AUTH_API_URL at it.
+ *
+ *   POST   /api/v1/sessions           { email, password } -> 201 tokens | 422
+ *   POST   /api/v1/sessions/refresh   { refresh_token }   -> 200 tokens | 401
+ *   DELETE /api/v1/sessions           revokes { refresh_token } -> 204
+ *   GET    /api/v1/me                 Bearer token -> 200 user | 401
+ *   GET    /api/v1/notes              Bearer token -> 200 { items } | 401
+ *
+ * Account: field@example.com / notes-123. Refresh tokens rotate: a refresh
+ * returns a new pair and the old refresh token stops working.
+ *
+ * To test the app's error and retry states, create a file named `.fail`
+ * next to this one (`touch scripts/mock-backend/.fail`): every
+ * /api/v1/notes request then returns 503 until you delete it.
+ *
+ * Usage: npm run mock-backend   (PORT=4000 by default)
+ */
+const crypto = require('crypto');
+const fs = require('fs');
+const http = require('http');
+const path = require('path');
+
+const port = Number(process.env.PORT ?? 4000);
+const FAIL_FILE = path.join(__dirname, '.fail');
+const EXPIRES_IN = 900; // seconds
+
+const USER = {
+  id: 'u_1',
+  email: 'field@example.com',
+  display_name: 'Field Tester',
+};
+const PASSWORD = 'notes-123';
+
+const NOTES = [
+  {
+    id: 'n_1',
+    title: 'North wall: crack above window',
+    created_at: '2026-10-01T08:15:00Z',
+  },
+  {
+    id: 'n_2',
+    title: 'Level 2: missing fire stopping',
+    created_at: '2026-10-03T13:40:00Z',
+  },
+  {
+    id: 'n_3',
+    title: 'Roof: drainage outlet blocked',
+    created_at: '2026-10-07T10:05:00Z',
+  },
+];
+
+/** access token -> expiry (ms since epoch) */
+const accessTokens = new Map();
+const refreshTokens = new Set();
+
+function issueTokens() {
+  const access_token = crypto.randomBytes(24).toString('hex');
+  const refresh_token = crypto.randomBytes(24).toString('hex');
+  accessTokens.set(access_token, Date.now() + EXPIRES_IN * 1000);
+  refreshTokens.add(refresh_token);
+  return { access_token, refresh_token, expires_in: EXPIRES_IN };
+}
+
+function send(res, status, body) {
+  if (body === undefined) {
+    res.writeHead(status);
+    return res.end();
+  }
+  res.writeHead(status, { 'Content-Type': 'application/json' });
+  res.end(JSON.stringify(body));
+}
+
+const failure = (code, message) => ({ error: { code, message } });
+
+function readJson(req) {
+  return new Promise(resolve => {
+    let raw = '';
+    req.on('data', chunk => (raw += chunk));
+    req.on('end', () => {
+      try {
+        resolve(raw ? JSON.parse(raw) : {});
+      } catch {
+        resolve({});
+      }
+    });
+  });
+}
+
+/** True when the request carries an access token that hasn't expired. */
+function isAuthorized(req) {
+  const token = /^Bearer (.+)$/.exec(req.headers.authorization ?? '')?.[1];
+  const expiry = token ? accessTokens.get(token) : undefined;
+  if (expiry === undefined) return false;
+  if (expiry < Date.now()) {
+    accessTokens.delete(token);
+    return false;
+  }
+  return true;
+}
+
+const unauthorized = res =>
+  send(res, 401, failure('unauthorized', 'Missing or expired access token'));
+
+async function handle(req, res) {
+  const url = new URL(req.url ?? '/', 'http://localhost').pathname;
+  const route = `${req.method} ${url}`;
+
+  if (route === 'POST /api/v1/sessions') {
+    const { email, password } = await readJson(req);
+    return email === USER.email && password === PASSWORD
+      ? send(res, 201, { data: issueTokens() })
+      : send(
+          res,
+          422,
+          failure('invalid_credentials', 'Wrong email or password')
+        );
+  }
+  if (route === 'POST /api/v1/sessions/refresh') {
+    const { refresh_token } = await readJson(req);
+    if (!refreshTokens.delete(refresh_token)) {
+      return send(
+        res,
+        401,
+        failure('invalid_refresh_token', 'Unknown refresh token')
+      );
+    }
+    return send(res, 200, { data: issueTokens() });
+  }
+  if (route === 'DELETE /api/v1/sessions') {
+    const { refresh_token } = await readJson(req);
+    refreshTokens.delete(refresh_token);
+    return send(res, 204);
+  }
+  if (route === 'GET /api/v1/me') {
+    return isAuthorized(req)
+      ? send(res, 200, { data: USER })
+      : unauthorized(res);
+  }
+  if (url === '/api/v1/notes') {
+    if (fs.existsSync(FAIL_FILE)) {
+      return send(
+        res,
+        503,
+        failure('unavailable', 'Notes are temporarily unavailable')
+      );
+    }
+    if (req.method !== 'GET') {
+      return send(res, 405, failure('method_not_allowed', route));
+    }
+    return isAuthorized(req)
+      ? send(res, 200, { items: NOTES })
+      : unauthorized(res);
+  }
+  send(res, 404, failure('not_found', route));
+}
+
+http
+  .createServer((req, res) => {
+    handle(req, res)
+      .then(() =>
+        process.stdout.write(`${req.method} ${req.url} ${res.statusCode}\n`)
+      )
+      .catch(error => {
+        console.error(error);
+        send(res, 500, failure('internal', 'Mock backend error'));
+      });
+  })
+  .listen(port, () =>
+    process.stdout.write(
+      `Site Notes mock backend on http://localhost:${port}\n`
+    )
+  );
