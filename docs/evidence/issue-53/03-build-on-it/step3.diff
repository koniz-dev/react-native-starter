@@ -0,0 +1,29 @@
+import { z } from 'zod';
+import { api } from '@/shared/http/api';
+import type { Note } from '../types';
+
+const notesResponseSchema = z.object({
+  items: z.array(
+    z.object({
+      id: z.string(),
+      title: z.string(),
+      created_at: z.string(),
+    })
+  ),
+});
+
+export const notesApi = {
+  /** GET /api/v1/notes; throws if the response isn't a list of notes. */
+  list: async (signal?: AbortSignal): Promise<Note[]> => {
+    const { data } = await api.get<unknown>('/api/v1/notes', { signal });
+    const parsed = notesResponseSchema.safeParse(data);
+    if (!parsed.success) {
+      throw new Error('The notes response was not in the expected format');
+    }
+    return parsed.data.items.map(item => ({
+      id: item.id,
+      title: item.title,
+      createdAt: item.created_at,
+    }));
+  },
+};
diff --git a/features/notes/components/NotesList.tsx b/features/notes/components/NotesList.tsx
