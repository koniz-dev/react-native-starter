+/**
+ * A fake analytics provider: keeps every call in memory and logs it. Stands
+ * in for a real SDK until we pick one, and lets tests and the debugger see
+ * exactly what the app reports.
+ */
+import { logger } from '@/shared/lib/logger';
+import type { Analytics, AnalyticsProperties } from '../analytics';
+
+export type AnalyticsRecord =
+  | { type: 'track'; name: string; properties?: AnalyticsProperties }
+  | { type: 'screen'; name: string; properties?: AnalyticsProperties }
+  | { type: 'identify'; userId: string | null; traits?: AnalyticsProperties };
+
+export interface MemoryAnalytics extends Analytics {
+  /** Everything recorded so far, oldest first. */
+  readonly records: readonly AnalyticsRecord[];
+  /** Forgets the recorded calls. */
+  clear(): void;
+}
+
+/** Creates an Analytics provider that records calls, keeping at most `limit`. */
+export function createMemoryAnalytics(limit = 500): MemoryAnalytics {
+  const records: AnalyticsRecord[] = [];
+  const record = (entry: AnalyticsRecord) => {
+    records.push(entry);
+    if (records.length > limit) records.shift();
+    logger.debug(`[analytics] ${entry.type}`, { ...entry });
+  };
+  return {
+    records,
+    clear: () => {
+      records.length = 0;
+    },
+    track: (name, properties) => record({ type: 'track', name, properties }),
+    screen: (name, properties) => record({ type: 'screen', name, properties }),
+    identify: (userId, traits) => record({ type: 'identify', userId, traits }),
+  };
+}
