+import { fireEvent } from '@testing-library/react-native';
+import { renderRouter, screen } from 'expo-router/testing-library';
+
+describe('Notes tab', () => {
+  it('opens from the tab bar and sends a signed-out user to Login', async () => {
+    const app = renderRouter('./app', { initialUrl: '/' });
+    await screen.findByText('Not signed in');
+
+    fireEvent.press(screen.getByTestId('tab-notes'));
+    expect(await screen.findByText('Sign in to see your notes')).toBeTruthy();
+    expect(app.getPathname()).toBe('/notes');
+
+    fireEvent.press(screen.getByTestId('notes-sign-in'));
+    expect(await screen.findByText('Welcome Back')).toBeTruthy();
+    expect(app.getPathname()).toBe('/login');
+  });
+});
diff --git a/__tests__/features/auth/siteNotesAdapter.test.ts b/__tests__/features/auth/siteNotesAdapter.test.ts
new file mode 100644
index 0000000..33f69fc
--- /dev/null
+++ b/__tests__/features/auth/siteNotesAdapter.test.ts
@@ -0,0 +1,275 @@
+/**
+ * Runs the Site Notes AuthAdapter against a fake backend with the contract
+ * scripts/mock-backend/server.js implements: `{ data }` envelopes, a
+ * tokens-only login plus GET /api/v1/me, rotating refresh tokens, and an
+ * `{ error: { code, message } }` envelope. The requests go through the real
+ * auth clients, session service, and token stores.
+ */
+import type {
+  AxiosAdapter,
+  AxiosResponse,
+  InternalAxiosRequestConfig,
+} from 'axios';
+import { AxiosError, AxiosHeaders } from 'axios';
+import { siteNotesAuthAdapter } from '@/features/auth/siteNotesAdapter';
+import {
+  authClients,
+  authService,
+  setAuthAdapter,
+} from '@/shared/session/authService';
+import { STORAGE_KEYS } from '@/shared/storage/storage';
+import { secureStore } from '@/testing';
+
+const REFRESH_KEY = 'refresh_token';
+const USER = {
+  id: 'u_1',
+  email: 'field@example.com',
+  display_name: 'Field Tester',
+};
+
+interface Request {
+  method: string;
+  url: string;
+  authorization: string | undefined;
+  body: unknown;
+}
+
+function fakeBackend() {
+  const requests: Request[] = [];
+  const state = {
+    issued: 0,
+    validAccess: new Set<string>(),
+    validRefresh: new Set<string>(),
+    me: { data: USER } as unknown,
+    tokens: null as unknown,
+  };
+  const issue = () => {
+    state.issued += 1;
+    const pair = {
+      access_token: `access-${state.issued}`,
+      refresh_token: `refresh-${state.issued}`,
+      expires_in: 900,
+    };
+    state.validAccess.add(pair.access_token);
+    state.validRefresh.add(pair.refresh_token);
+    return { data: pair };
+  };
+  const respond = (
+    config: InternalAxiosRequestConfig,
+    status: number,
+    data: unknown
+  ): AxiosResponse => {
+    const response = {
+      data,
+      status,
+      statusText: String(status),
+      headers: {},
+      config,
+    };
+    if (status < 400) return response;
+    throw new AxiosError(
+      `Request failed with status code ${status}`,
+      'ERR_BAD_REQUEST',
+      config,
+      null,
+      { ...response, headers: new AxiosHeaders() }
+    );
+  };
+  const failure = (code: string, message: string) => ({
+    error: { code, message },
+  });
+
+  const adapter: AxiosAdapter = async config => {
+    const body: unknown =
+      typeof config.data === 'string' ? JSON.parse(config.data) : config.data;
+    const authorization = config.headers.Authorization as string | undefined;
+    const method = (config.method ?? 'get').toUpperCase();
+    const url = config.url ?? '';
+    requests.push({ method, url, authorization, body });
+    const bearer = authorization?.replace(/^Bearer /, '');
+    const { email, password, refresh_token } = (body ?? {}) as Record<
+      string,
+      string
+    >;
+
+    if (method === 'POST' && url === '/api/v1/sessions') {
+      if (email !== USER.email || password !== 'notes-123') {
+        return respond(
+          config,
+          422,
+          failure('invalid_credentials', 'Wrong email or password')
+        );
+      }
+      return respond(config, 201, state.tokens ?? issue());
+    }
+    if (method === 'GET' && url === '/api/v1/me') {
+      return bearer && state.validAccess.has(bearer)
+        ? respond(config, 200, state.me)
+        : respond(config, 401, failure('unauthorized', 'Token expired'));
+    }
+    if (method === 'POST' && url === '/api/v1/sessions/refresh') {
+      if (!state.validRefresh.delete(refresh_token ?? '')) {
+        return respond(config, 401, failure('invalid_refresh', 'Unknown'));
+      }
+      return respond(config, 200, issue());
+    }
+    if (method === 'DELETE' && url === '/api/v1/sessions') {
+      state.validRefresh.delete(refresh_token ?? '');
+      return respond(config, 204, '');
+    }
+    return respond(config, 404, failure('not_found', `${method} ${url}`));
+  };
+  return { adapter, requests, state };
+}
+
+let backend: ReturnType<typeof fakeBackend>;
+const originalAdapters = {
+  public: authClients.public.defaults.adapter,
+  authenticated: authClients.authenticated.defaults.adapter,
+};
+
+beforeEach(() => {
+  backend = fakeBackend();
+  authClients.public.defaults.adapter = backend.adapter;
+  authClients.authenticated.defaults.adapter = backend.adapter;
+  setAuthAdapter(siteNotesAuthAdapter);
+});
+
+afterEach(() => {
+  authClients.public.defaults.adapter = originalAdapters.public;
+  authClients.authenticated.defaults.adapter = originalAdapters.authenticated;
+  setAuthAdapter(null);
+});
+
+const signIn = () =>
+  authService.login({ username: 'field@example.com', password: 'notes-123' });
+
+describe('siteNotesAuthAdapter', () => {
+  it('signs in, loading the user from /api/v1/me with the new token', async () => {
+    await expect(signIn()).resolves.toEqual({
+      token: 'access-1',
+      user: { id: 'u_1', email: 'field@example.com', name: 'Field Tester' },
+    });
+
+    expect(backend.requests).toEqual([
+      {
+        method: 'POST',
+        url: '/api/v1/sessions',
+        authorization: undefined,
+        body: { email: 'field@example.com', password: 'notes-123' },
+      },
+      {
+        method: 'GET',
+        url: '/api/v1/me',
+        authorization: 'Bearer access-1',
+        body: undefined,
+      },
+    ]);
+    expect(secureStore.get(STORAGE_KEYS.AUTH_TOKEN)).toBe('access-1');
+    expect(secureStore.get(REFRESH_KEY)).toBe('refresh-1');
+  });
+
+  it("shows the envelope's message for wrong credentials and stores nothing", async () => {
+    await expect(
+      authService.login({ username: 'field@example.com', password: 'nope' })
+    ).rejects.toMatchObject({
+      name: 'ApiError',
+      status: 422,
+      message: 'Wrong email or password',
+    });
+    expect(secureStore.size).toBe(0);
+  });
+
+  it('rejects a sign-in response without tokens', async () => {
+    backend.state.tokens = { data: { access_token: 'a' } };
+
+    await expect(signIn()).rejects.toThrow(
+      'The sign-in response did not include the tokens'
+    );
+    expect(secureStore.size).toBe(0);
+  });
+
+  it('rejects a /me response without the user', async () => {
+    backend.state.me = { data: { email: 'field@example.com' } };
+
+    await expect(signIn()).rejects.toThrow(
+      'The sign-in response did not include the user'
+    );
+    expect(secureStore.has(STORAGE_KEYS.AUTH_TOKEN)).toBe(false);
+  });
+
+  it('falls back to the email when the user has no display name', async () => {
+    backend.state.me = { data: { id: 'u_1', email: 'field@example.com' } };
+
+    await expect(signIn()).resolves.toMatchObject({
+      user: { name: 'field@example.com' },
+    });
+  });
+
+  it('refreshes on a 401 with rotation, keeping only the newest refresh token', async () => {
+    await signIn();
+    backend.state.validAccess.clear(); // the access token expires
+
+    await expect(authService.fetchProfile()).resolves.toMatchObject({
+      id: 'u_1',
+      name: 'Field Tester',
+    });
+    expect(
+      backend.requests.filter(r => r.url === '/api/v1/sessions/refresh')
+    ).toEqual([
+      expect.objectContaining({ body: { refresh_token: 'refresh-1' } }),
+    ]);
+    expect(backend.requests.at(-1)).toMatchObject({
+      url: '/api/v1/me',
+      authorization: 'Bearer access-2',
+    });
+    expect(secureStore.get(STORAGE_KEYS.AUTH_TOKEN)).toBe('access-2');
+    expect(secureStore.get(REFRESH_KEY)).toBe('refresh-2');
+  });
+
+  it('signs out and drops the refresh token when the refresh is rejected', async () => {
+    await signIn();
+    backend.state.validAccess.clear();
+    backend.state.validRefresh.clear();
+
+    await expect(authService.fetchProfile()).rejects.toMatchObject({
+      code: 'unauthorized',
+    });
+    expect(secureStore.has(STORAGE_KEYS.AUTH_TOKEN)).toBe(false);
+    expect(secureStore.has(REFRESH_KEY)).toBe(false);
+  });
+
+  it('signs out without a refresh request when there is no refresh token', async () => {
+    secureStore.set(STORAGE_KEYS.AUTH_TOKEN, 'expired');
+
+    await expect(authService.fetchProfile()).rejects.toMatchObject({
+      code: 'unauthorized',
+    });
+    expect(backend.requests.map(r => r.url)).toEqual(['/api/v1/me']);
+    expect(secureStore.has(STORAGE_KEYS.AUTH_TOKEN)).toBe(false);
+  });
+
+  it('revokes the refresh token on logout', async () => {
+    await signIn();
+
+    await authService.logout();
+
+    expect(backend.requests.at(-1)).toEqual({
+      method: 'DELETE',
+      url: '/api/v1/sessions',
+      authorization: 'Bearer access-1',
+      body: { refresh_token: 'refresh-1' },
+    });
+    expect(backend.state.validRefresh.has('refresh-1')).toBe(false);
+    expect(secureStore.size).toBe(0);
+  });
+
+  it('skips the revoke request on logout without a refresh token', async () => {
+    secureStore.set(STORAGE_KEYS.AUTH_TOKEN, 'access-x');
+
+    await authService.logout();
+
+    expect(backend.requests).toHaveLength(0);
+    expect(secureStore.size).toBe(0);
+  });
+});
diff --git a/__tests__/features/notes/NotesScreen.test.tsx b/__tests__/features/notes/NotesScreen.test.tsx
new file mode 100644
index 0000000..bd859e9
--- /dev/null
+++ b/__tests__/features/notes/NotesScreen.test.tsx
@@ -0,0 +1,161 @@
+import {
+  AxiosError,
+  AxiosHeaders,
+  type AxiosAdapter,
+  type AxiosResponse,
+  type InternalAxiosRequestConfig,
+} from 'axios';
+import { act, fireEvent, screen, waitFor } from '@testing-library/react-native';
+
+jest.mock('expo-router', () => ({ router: { push: jest.fn() } }));
+
+import { router } from 'expo-router';
+import { NotesScreen } from '@/features/notes/screens/NotesScreen';
+import { api } from '@/shared/http/api';
+import { analyticsSeam, type Analytics } from '@/shared/integrations/analytics';
+import { STORAGE_KEYS } from '@/shared/storage/storage';
+import { renderWithProviders, secureStore } from '@/testing';
+
+interface HeldRequest {
+  config: InternalAxiosRequestConfig;
+  resolve: (response: AxiosResponse) => void;
+  reject: (error: unknown) => void;
+}
+
+/** Replaces the API's adapter: each request waits until the test answers. */
+function holdRequests(): HeldRequest[] {
+  const held: HeldRequest[] = [];
+  api.defaults.adapter = (config =>
+    new Promise((resolve, reject) =>
+      held.push({ config, resolve, reject })
+    )) as AxiosAdapter;
+  return held;
+}
+
+const ok = (config: InternalAxiosRequestConfig, data: unknown) => ({
+  data,
+  status: 200,
+  statusText: 'OK',
+  headers: {},
+  config,
+});
+
+const unavailable = (config: InternalAxiosRequestConfig) =>
+  new AxiosError('Request failed', 'ERR_BAD_RESPONSE', config, null, {
+    data: {
+      error: {
+        code: 'unavailable',
+        message: 'Notes are temporarily unavailable',
+      },
+    },
+    status: 503,
+    statusText: 'Service Unavailable',
+    headers: new AxiosHeaders(),
+    config,
+  });
+
+const NOTES = {
+  items: [
+    {
+      id: 'n_1',
+      title: 'Crack above window',
+      created_at: '2026-10-01T08:15:00Z',
+    },
+    { id: 'n_2', title: 'Blocked drain', created_at: '2026-10-03T13:40:00Z' },
+  ],
+};
+
+const analytics: Analytics = {
+  track: jest.fn(),
+  screen: jest.fn(),
+  identify: jest.fn(),
+};
+
+const originalAdapter = api.defaults.adapter;
+
+beforeEach(() => {
+  jest.clearAllMocks();
+  analyticsSeam.set(analytics);
+});
+
+afterEach(() => {
+  api.defaults.adapter = originalAdapter;
+  analyticsSeam.reset();
+});
+
+const signIn = () => secureStore.set(STORAGE_KEYS.AUTH_TOKEN, 'stored-token');
+
+describe('<NotesScreen />', () => {
+  it('asks a signed-out user to sign in and sends no request', async () => {
+    const requests = holdRequests();
+    renderWithProviders(<NotesScreen />, { withSession: true });
+
+    fireEvent.press(await screen.findByText('Sign in'));
+
+    expect(screen.getByText('Sign in to see your notes')).toBeTruthy();
+    expect(router.push).toHaveBeenCalledWith('/login');
+    expect(requests).toHaveLength(0);
+  });
+
+  it('shows loading, then the error, and Retry loads the list', async () => {
+    signIn();
+    const requests = holdRequests();
+    renderWithProviders(<NotesScreen />, { withSession: true });
+
+    expect(await screen.findByText('Loading notes…')).toBeTruthy();
+    await waitFor(() => expect(requests).toHaveLength(1));
+    expect(requests[0]?.config.url).toBe('/api/v1/notes');
+
+    await act(async () => requests[0]?.reject(unavailable(requests[0].config)));
+    expect(await screen.findByText('Could not load your notes')).toBeTruthy();
+    expect(screen.getByText('Notes are temporarily unavailable')).toBeTruthy();
+
+    fireEvent.press(screen.getByText('Retry'));
+    expect(analytics.track).toHaveBeenCalledWith('notes_retry', {
+      error: 'server',
+    });
+
+    expect(await screen.findByText('Loading notes…')).toBeTruthy();
+    await waitFor(() => expect(requests).toHaveLength(2));
+    await act(async () => requests[1]?.resolve(ok(requests[1].config, NOTES)));
+
+    expect(await screen.findByText('Crack above window')).toBeTruthy();
+    expect(screen.getByText('Blocked drain')).toBeTruthy();
+    expect(screen.queryByText('Retry')).toBeNull();
+    expect(analytics.track).toHaveBeenLastCalledWith('notes_loaded', {
+      count: 2,
+    });
+  });
+
+  it('shows an empty state when there are no notes', async () => {
+    signIn();
+    const requests = holdRequests();
+    renderWithProviders(<NotesScreen />, { withSession: true });
+
+    await waitFor(() => expect(requests).toHaveLength(1));
+    await act(async () =>
+      requests[0]?.resolve(ok(requests[0].config, { items: [] }))
+    );
+
+    expect(await screen.findByText('No notes yet')).toBeTruthy();
+  });
+
+  it('treats a response in the wrong shape as an error', async () => {
+    signIn();
+    const requests = holdRequests();
+    renderWithProviders(<NotesScreen />, { withSession: true });
+
+    await waitFor(() => expect(requests).toHaveLength(1));
+    await act(async () =>
+      requests[0]?.resolve(ok(requests[0].config, [{ id: 1 }]))
+    );
+
+    expect(
+      await screen.findByText(
+        'The notes response was not in the expected format'
+      )
+    ).toBeTruthy();
+    expect(screen.getByText('Retry')).toBeTruthy();
+    expect(analytics.track).not.toHaveBeenCalled();
+  });
+});
