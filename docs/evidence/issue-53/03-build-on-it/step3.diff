diff --git a/features/auth/siteNotesAdapter.ts b/features/auth/siteNotesAdapter.ts
new file mode 100644
index 0000000..5abe4ce
--- /dev/null
+++ b/features/auth/siteNotesAdapter.ts
@@ -0,0 +1,124 @@
+/**
+ * Sign-in against the Site Notes backend (scripts/mock-backend/server.js
+ * mocks it locally). Every success body is wrapped in `{ "data": ... }`:
+ *
+ * - `POST /api/v1/sessions` `{ email, password }` returns only tokens; the
+ *   user comes from `GET /api/v1/me`.
+ * - `POST /api/v1/sessions/refresh` rotates the refresh token.
+ * - `DELETE /api/v1/sessions` revokes a refresh token.
+ *
+ * Errors use the `{ "error": { code, message } }` envelope, which ApiError
+ * already reads.
+ */
+import { Platform } from 'react-native';
+import { z } from 'zod';
+import type { AuthAdapter } from '@/shared/session/authService';
+import {
+  createMemoryTokenStore,
+  createSecureTokenStore,
+} from '@/shared/session/tokenStore';
+
+const tokensSchema = z.object({
+  data: z.object({
+    access_token: z.string().min(1),
+    refresh_token: z.string().min(1),
+    expires_in: z.number(),
+  }),
+});
+
+const userSchema = z.object({
+  id: z.string().min(1),
+  email: z.string().min(1),
+  display_name: z.string().optional(),
+});
+
+const meSchema = z.object({ data: z.unknown() });
+
+/** Unwraps the token pair, throwing if the response isn't what we expect. */
+function parseTokens(body: unknown) {
+  const parsed = tokensSchema.safeParse(body);
+  if (!parsed.success) {
+    throw new Error('The sign-in response did not include the tokens');
+  }
+  return parsed.data.data;
+}
+
+/** Unwraps `{ data: user }` from GET /me; normalizeUser validates the user. */
+const unwrapUser = (body: unknown): unknown =>
+  meSchema.safeParse(body).data?.data;
+
+// Kept like the access token: Keychain / Keystore on native, memory on web
+// (secure storage isn't available there).
+export const siteNotesRefreshTokens =
+  Platform.OS === 'web'
+    ? createMemoryTokenStore()
+    : createSecureTokenStore('refresh_token');
+
+export const siteNotesAuthAdapter: AuthAdapter = {
+  // The Login form's username field holds the email.
+  login: async ({ username, password }, { public: http }) => {
+    const tokens = parseTokens(
+      (
+        await http.post<unknown>('/api/v1/sessions', {
+          email: username,
+          password,
+        })
+      ).data
+    );
+    // The token isn't stored until login returns, so pass it explicitly.
+    const { data: me } = await http.get<unknown>('/api/v1/me', {
+      headers: { Authorization: `Bearer ${tokens.access_token}` },
+    });
+    await siteNotesRefreshTokens.set(tokens.refresh_token);
+    return { token: tokens.access_token, user: unwrapUser(me) };
+  },
+
+  normalizeUser: raw => {
+    const parsed = userSchema.safeParse(raw);
+    if (!parsed.success) {
+      throw new Error('The sign-in response did not include the user');
+    }
+    const user = parsed.data;
+    return {
+      id: user.id,
+      email: user.email,
+      name: user.display_name || user.email,
+    };
+  },
+
+  fetchUser: async ({ authenticated }) =>
+    unwrapUser((await authenticated.get<unknown>('/api/v1/me')).data),
+
+  refresh: async ({ public: http }) => {
+    const refreshToken = await siteNotesRefreshTokens.get();
+    if (!refreshToken) return null;
+    try {
+      const tokens = parseTokens(
+        (
+          await http.post<unknown>('/api/v1/sessions/refresh', {
+            refresh_token: refreshToken,
+          })
+        ).data
+      );
+      // Rotation: the old refresh token no longer works.
+      await siteNotesRefreshTokens.set(tokens.refresh_token);
+      return tokens.access_token;
+    } catch (error) {
+      // The user is signed out next, so drop the rejected refresh token.
+      await siteNotesRefreshTokens.clear();
+      throw error;
+    }
+  },
+
+  // Delete the refresh token before the request, so a failed request
+  // doesn't leave it on the device.
+  logout: async ({ authenticated }) => {
+    const refreshToken = await siteNotesRefreshTokens.get();
+    await siteNotesRefreshTokens.clear();
+    if (refreshToken) {
+      await authenticated.delete('/api/v1/sessions', {
+        data: { refresh_token: refreshToken },
+      });
+    }
+  },
+};
diff --git a/features/notes/api/notesApi.ts b/features/notes/api/notesApi.ts
