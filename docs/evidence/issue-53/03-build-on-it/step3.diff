@@ -0,0 +1,82 @@
+import { FlatList, StyleSheet, View } from 'react-native';
+import { Button, Divider, List, Text, useTheme } from 'react-native-paper';
+import { t } from '@/shared/i18n';
+import { getAnalytics } from '@/shared/integrations/analytics';
+import { useFetch } from '@/shared/lib/useFetch';
+import { LoadingScreen } from '@/shared/ui/LoadingScreen';
+import { notesApi } from '../api/notesApi';
+
+/** The signed-in user's notes: loading, error with Retry, or the list. */
+export function NotesList() {
+  const theme = useTheme();
+  const { data, loading, error, refetch } = useFetch(async signal => {
+    const notes = await notesApi.list(signal);
+    getAnalytics().track('notes_loaded', { count: notes.length });
+    return notes;
+  });
+
+  const retry = () => {
+    getAnalytics().track('notes_retry', { error: error?.code ?? null });
+    void refetch();
+  };
+
+  if (loading && !data) return <LoadingScreen message={t('notes.loading')} />;
+
+  if (error) {
+    return (
+      <View style={styles.centered} testID="notes-error">
+        <Text variant="titleMedium">{t('notes.error.title')}</Text>
+        <Text
+          variant="bodyMedium"
+          style={[styles.message, { color: theme.colors.onSurfaceVariant }]}
+        >
+          {error.message}
+        </Text>
+        <Button mode="contained" onPress={retry} testID="notes-retry">
+          {t('notes.retry')}
+        </Button>
+      </View>
+    );
+  }
+
+  return (
+    <FlatList
+      data={data ?? []}
+      keyExtractor={note => note.id}
+      refreshing={loading}
+      onRefresh={refetch}
+      ItemSeparatorComponent={Divider}
+      contentContainerStyle={data?.length ? undefined : styles.centered}
+      ListEmptyComponent={
+        <Text
+          variant="bodyMedium"
+          style={{ color: theme.colors.onSurfaceVariant }}
+        >
+          {t('notes.empty')}
+        </Text>
+      }
+      renderItem={({ item }) => (
+        <List.Item
+          title={item.title}
+          description={new Date(item.createdAt).toLocaleDateString()}
+          left={props => <List.Icon {...props} icon="note-text-outline" />}
+          testID={`note-${item.id}`}
+        />
+      )}
+      testID="notes-list"
+    />
+  );
+}
+
+const styles = StyleSheet.create({
+  centered: {
+    flexGrow: 1,
+    alignItems: 'center',
+    justifyContent: 'center',
+    gap: 12,
+    padding: 24,
+  },
+  message: {
+    textAlign: 'center',
+  },
+});
