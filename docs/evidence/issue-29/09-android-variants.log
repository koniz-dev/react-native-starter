# aapt2 dump badging (package, label) for the two APKs built from this commit's config
== rnstarter-dev-debug.apk
package: name='com.example.rnstarter.dev' versionCode='1' versionName='1.0.0'
application-label:'RN Starter (Dev)'
launchable-activity: name='com.example.rnstarter.dev.MainActivity'  label='' icon=''
== rnstarter-preview-release.apk
package: name='com.example.rnstarter.preview' versionCode='1' versionName='1.0.0'
application-label:'RN Starter (Preview)'
launchable-activity: name='com.example.rnstarter.preview.MainActivity'  label='' icon=''

# adb shell pm list packages | grep rnstarter (both installed on Medium_Phone_API_37.0 at the same time)
package:com.example.rnstarter.dev
package:com.example.rnstarter.preview

# Generated splash resources after APP_VARIANT=preview npx expo prebuild
values/colors.xml:        <color name="splashscreen_background">#ffffff</color>
values-night/colors.xml:  <color name="splashscreen_background">#151718</color>
values/strings.xml:       <string name="app_name">RN Starter (Preview)</string>

# Gradle (Temurin JDK 17, x86_64)
development: ./gradlew assembleDebug  -> BUILD SUCCESSFUL in 10m 16s
preview:     ./gradlew assembleRelease -> BUILD SUCCESSFUL in 7m 48s
