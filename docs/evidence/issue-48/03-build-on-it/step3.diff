+import { fireEvent, screen, waitFor } from '@testing-library/react-native';
+import { router } from 'expo-router';
+import {
+  AxiosError,
+  type AxiosAdapter,
+  type AxiosResponse,
+  type InternalAxiosRequestConfig,
+} from 'axios';
+import { NotesScreen } from '@/features/notes/screens/NotesScreen';
+import { api } from '@/shared/http/api';
+import { analyticsSeam, type Analytics } from '@/shared/integrations/analytics';
+import { setItem, STORAGE_KEYS } from '@/shared/storage/storage';
+import { renderWithProviders, secureStore } from '@/testing';
+
+jest.mock('expo-router', () => ({ router: { push: jest.fn() } }));
+jest.mock('@/shared/lib/logger', () => ({
+  logger: {
+    warn: jest.fn(),
+    error: jest.fn(),
+    info: jest.fn(),
+    debug: jest.fn(),
+  },
+}));
+
+const notes = {
+  items: [
+    {
+      id: 'n_1',
+      title: 'Heron nest by the bank',
+      created_at: '2026-10-09T08:00:00Z',
+    },
+    {
+      id: 'n_2',
+      title: 'Bridge washed out',
+      created_at: '2026-10-07T08:00:00Z',
+    },
+  ],
+};
+
+/** Each request waits until the test answers it with a status and body. */
+function heldRequests() {
+  const pending: {
+    config: InternalAxiosRequestConfig;
+    respond: (status: number, data: unknown) => void;
+  }[] = [];
+  const adapter: AxiosAdapter = config =>
+    new Promise<AxiosResponse>((resolve, reject) => {
+      pending.push({
+        config,
+        respond: (status, data) => {
+          const response = {
+            data,
+            status,
+            statusText: '',
+            headers: {},
+            config,
+          };
+          if (status >= 400) {
+            reject(
+              new AxiosError(
+                'failed',
+                'ERR_BAD_RESPONSE',
+                config,
+                null,
+                response
+              )
+            );
+          } else {
+            resolve(response);
+          }
+        },
+      });
+    });
+  api.defaults.adapter = adapter;
+  return pending;
+}
+
+async function signIn() {
+  secureStore.set(STORAGE_KEYS.AUTH_TOKEN, 'at1');
+  await setItem(STORAGE_KEYS.USER_DATA, {
+    id: 'u_1',
+    email: 'field@example.com',
+    name: 'Field Tester',
+  });
+}
+
+describe('NotesScreen', () => {
+  const originalAdapter = api.defaults.adapter;
+  let analytics: jest.Mocked<Analytics>;
+
+  beforeEach(() => {
+    analytics = { track: jest.fn(), screen: jest.fn(), identify: jest.fn() };
+    analyticsSeam.set(analytics);
+  });
+
+  afterEach(() => {
+    api.defaults.adapter = originalAdapter;
+    analyticsSeam.reset();
+    jest.clearAllMocks();
+  });
+
+  it('asks a signed-out user to sign in and sends no request', async () => {
+    const requests = heldRequests();
+    renderWithProviders(<NotesScreen />, { withSession: true });
+
+    fireEvent.press(await screen.findByTestId('notes-sign-in'));
+
+    expect(screen.getByText('Sign in to see your notes.')).toBeTruthy();
+    expect(router.push).toHaveBeenCalledWith('/login');
+    expect(requests).toHaveLength(0);
+  });
+
+  it('shows loading, then the error, then the list after Retry', async () => {
+    await signIn();
+    const requests = heldRequests();
+    renderWithProviders(<NotesScreen />, { withSession: true });
+
+    expect(await screen.findByText('Loading notes…')).toBeTruthy();
+    expect(requests[0]?.config.url).toBe('/api/v1/notes');
+
+    requests[0]?.respond(503, {
+      error: {
+        code: 'unavailable',
+        message: 'Notes are temporarily unavailable',
+      },
+    });
+    expect(
+      await screen.findByText(
+        'Could not load your notes: Notes are temporarily unavailable'
+      )
+    ).toBeTruthy();
+
+    fireEvent.press(screen.getByTestId('notes-retry'));
+    expect(analytics.track).toHaveBeenCalledWith('notes_retry', {
+      error: 'server',
+    });
+    expect(await screen.findByText('Loading notes…')).toBeTruthy();
+
+    requests[1]?.respond(200, notes);
+    expect(await screen.findByText('Heron nest by the bank')).toBeTruthy();
+    expect(screen.getByText('Bridge washed out')).toBeTruthy();
+    expect(screen.queryByTestId('notes-error')).toBeNull();
+    expect(analytics.track).toHaveBeenCalledWith('notes_loaded', { count: 2 });
+  });
+
+  it('shows an empty state when there are no notes', async () => {
+    await signIn();
+    const requests = heldRequests();
+    renderWithProviders(<NotesScreen />, { withSession: true });
+    await screen.findByText('Loading notes…');
+
+    requests[0]?.respond(200, { items: [] });
+
+    expect(await screen.findByText('No notes yet.')).toBeTruthy();
+    expect(analytics.track).toHaveBeenCalledWith('notes_loaded', { count: 0 });
+  });
+
+  it('pull to refresh reloads the list and keeps it on screen meanwhile', async () => {
+    await signIn();
+    const requests = heldRequests();
+    renderWithProviders(<NotesScreen />, { withSession: true });
+    await screen.findByText('Loading notes…');
+    requests[0]?.respond(200, { items: [] });
+    await screen.findByText('No notes yet.');
+
+    fireEvent(screen.getByTestId('notes-list'), 'refresh');
+    await waitFor(() => expect(requests).toHaveLength(2));
+    expect(screen.getByText('No notes yet.')).toBeTruthy();
+
+    requests[1]?.respond(200, notes);
+    expect(await screen.findByText('Heron nest by the bank')).toBeTruthy();
+  });
+
+  it('treats a malformed response as an error instead of rendering it', async () => {
+    await signIn();
+    const requests = heldRequests();
+    renderWithProviders(<NotesScreen />, { withSession: true });
+    await screen.findByText('Loading notes…');
+
+    requests[0]?.respond(200, { notes: 'nope' });
+
+    expect(
+      await screen.findByText(
+        'Could not load your notes: The server sent an unexpected response'
+      )
+    ).toBeTruthy();
+  });
+});
