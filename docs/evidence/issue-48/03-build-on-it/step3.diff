+import {
+  createMemoryAnalytics,
+  type MemoryAnalytics,
+} from '@/shared/integrations/adapters/memoryAnalytics';
+import { analyticsSeam, getAnalytics } from '@/shared/integrations/analytics';
+import { configureIntegrations } from '@/shared/integrations/setup';
+import { logger } from '@/shared/lib/logger';
+
+jest.mock('@/shared/lib/logger', () => ({
+  logger: {
+    warn: jest.fn(),
+    error: jest.fn(),
+    info: jest.fn(),
+    debug: jest.fn(),
+  },
+}));
+
+describe('memory analytics', () => {
+  afterEach(() => analyticsSeam.reset());
+
+  it('records track, screen, and identify calls in order and logs each one', () => {
+    const analytics = createMemoryAnalytics();
+
+    analytics.screen('/notes');
+    analytics.track('notes_loaded', { count: 3 });
+    analytics.identify('u_1', { plan: 'free' });
+    analytics.identify(null);
+
+    expect(analytics.events).toEqual([
+      { type: 'screen', name: '/notes', properties: null },
+      { type: 'track', name: 'notes_loaded', properties: { count: 3 } },
+      { type: 'identify', userId: 'u_1', traits: { plan: 'free' } },
+      { type: 'identify', userId: null, traits: null },
+    ]);
+    expect(logger.debug).toHaveBeenCalledWith('[analytics:memory] track', {
+      name: 'notes_loaded',
+      properties: { count: 3 },
+    });
+  });
+
+  it('keeps only the newest events up to the limit, and clears', () => {
+    const analytics = createMemoryAnalytics(2);
+
+    analytics.track('a');
+    analytics.track('b');
+    analytics.track('c');
+    expect(
+      analytics.events.map(e => (e.type === 'track' ? e.name : ''))
+    ).toEqual(['b', 'c']);
+
+    analytics.clear();
+    expect(analytics.events).toEqual([]);
+  });
+
+  it('is the analytics provider the app registers', () => {
+    configureIntegrations();
+    const analytics = getAnalytics() as Partial<MemoryAnalytics>;
+
+    analytics.track?.('probe');
+
+    expect(analytics.events).toContainEqual({
+      type: 'track',
+      name: 'probe',
+      properties: null,
+    });
+  });
+});
