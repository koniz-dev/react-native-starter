+import {
+  AxiosError,
+  type AxiosAdapter,
+  type InternalAxiosRequestConfig,
+} from 'axios';
+import {
+  fieldNotesAuthAdapter,
+  refreshTokenStore,
+} from '@/features/auth/fieldNotesAuthAdapter';
+import {
+  authClients,
+  authService,
+  setAuthAdapter,
+} from '@/shared/session/authService';
+import { getItem, STORAGE_KEYS } from '@/shared/storage/storage';
+import { secureStore } from '@/testing';
+
+jest.mock('@/shared/lib/logger', () => ({
+  logger: {
+    warn: jest.fn(),
+    error: jest.fn(),
+    info: jest.fn(),
+    debug: jest.fn(),
+  },
+}));
+
+interface Request {
+  method: string;
+  url: string;
+  authorization: string | undefined;
+  body: unknown;
+}
+
+/** A stand-in for mock-backend/server.js: answers by "METHOD url". */
+function fakeBackend(
+  routes: Record<string, (request: Request) => [number, unknown?]>
+) {
+  const requests: Request[] = [];
+  const adapter: AxiosAdapter = async (config: InternalAxiosRequestConfig) => {
+    const request: Request = {
+      method: (config.method ?? 'get').toUpperCase(),
+      url: config.url ?? '',
+      authorization: config.headers.Authorization as string | undefined,
+      body:
+        typeof config.data === 'string' ? JSON.parse(config.data) : undefined,
+    };
+    requests.push(request);
+    const route = routes[`${request.method} ${request.url}`];
+    const [status, data] = route ? route(request) : [404];
+    const response = { data, status, statusText: '', headers: {}, config };
+    if (status >= 400) {
+      throw new AxiosError('failed', 'ERR_BAD_REQUEST', config, null, response);
+    }
+    return response;
+  };
+  authClients.public.defaults.adapter = adapter;
+  authClients.authenticated.defaults.adapter = adapter;
+  return requests;
+}
+
+// Tests run with the demo backend URLs (jest.setup.env.js), where the API is
+// a different origin from the auth backend and never gets the token, so
+// requests that need it go through the auth backend's authenticated client.
+const authenticatedGet = (url: string) => authClients.authenticated.get(url);
+
+const me = {
+  data: { id: 'u_1', email: 'field@example.com', display_name: 'Field Tester' },
+};
+const tokens = (n: number) => ({
+  data: { access_token: `at${n}`, refresh_token: `rt${n}`, expires_in: 900 },
+});
+
+describe('fieldNotesAuthAdapter', () => {
+  const originalAdapter = authClients.public.defaults.adapter;
+
+  beforeEach(() => setAuthAdapter(fieldNotesAuthAdapter));
+
+  afterEach(() => {
+    setAuthAdapter(null);
+    authClients.public.defaults.adapter = originalAdapter;
+    authClients.authenticated.defaults.adapter = originalAdapter;
+  });
+
+  it('signs in with the email, loads the user with the new token, and keeps both tokens', async () => {
+    const requests = fakeBackend({
+      'POST /api/v1/sessions': () => [201, tokens(1)],
+      'GET /api/v1/me': () => [200, me],
+    });
+
+    await expect(
+      authService.login({
+        username: 'field@example.com',
+        password: 'notes-123',
+      })
+    ).resolves.toEqual({
+      token: 'at1',
+      user: { id: 'u_1', email: 'field@example.com', name: 'Field Tester' },
+    });
+
+    expect(requests[0]?.body).toEqual({
+      email: 'field@example.com',
+      password: 'notes-123',
+    });
+    expect(requests[1]?.authorization).toBe('Bearer at1');
+    expect(secureStore.get(STORAGE_KEYS.AUTH_TOKEN)).toBe('at1');
+    expect(await refreshTokenStore.get()).toBe('rt1');
+    expect(await getItem(STORAGE_KEYS.USER_DATA)).toMatchObject({
+      name: 'Field Tester',
+    });
+  });
+
+  it("shows the backend's message for wrong credentials and stores nothing", async () => {
+    fakeBackend({
+      'POST /api/v1/sessions': () => [
+        422,
+        {
+          error: {
+            code: 'invalid_credentials',
+            message: 'Email or password is incorrect',
+          },
+        },
+      ],
+    });
+
+    await expect(
+      authService.login({ username: 'field@example.com', password: 'nope' })
+    ).rejects.toThrow('Email or password is incorrect');
+    expect(secureStore.size).toBe(0);
+  });
+
+  it('rejects a session response without tokens', async () => {
+    fakeBackend({ 'POST /api/v1/sessions': () => [201, { data: {} }] });
+
+    await expect(
+      authService.login({
+        username: 'field@example.com',
+        password: 'notes-123',
+      })
+    ).rejects.toThrow();
+    expect(secureStore.size).toBe(0);
+  });
+
+  it('falls back to the email when the user has no display name, and rejects an incomplete user', () => {
+    expect(
+      fieldNotesAuthAdapter.normalizeUser({ id: 'u_2', email: 'a@b.c' })
+    ).toEqual({ id: 'u_2', email: 'a@b.c', name: 'a@b.c' });
+    expect(() =>
