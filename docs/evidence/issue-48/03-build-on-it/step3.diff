new file mode 100644
index 0000000..f847522
--- /dev/null
+++ b/mock-backend/server.js
@@ -0,0 +1,180 @@
+#!/usr/bin/env node
+/**
+ * Local mock of the Field Notes backend (npm run mock-backend). Plain Node
+ * http, no dependencies, state in memory (restarting it signs everyone out).
+ *
+ *   POST   /api/v1/sessions          { email, password } -> 201 tokens | 422
+ *   POST   /api/v1/sessions/refresh  { refresh_token }   -> 200 tokens | 401
+ *   DELETE /api/v1/sessions                              -> 204
+ *   GET    /api/v1/me                (Bearer)            -> 200 user   | 401
+ *   GET    /api/v1/notes             (Bearer)            -> 200 items  | 401
+ *
+ * While the file mock-backend/.fail exists, every /api/v1/notes request
+ * returns 503, so the app's error and retry states can be tried:
+ *
+ *   touch mock-backend/.fail   # fail
+ *   rm mock-backend/.fail      # recover
+ *
+ * Sign in with field@example.com / notes-123. Port: PORT (default 4000).
+ */
+const crypto = require('crypto');
+const fs = require('fs');
+const http = require('http');
+const path = require('path');
+
+const port = Number(process.env.PORT || 4000);
+const FAIL_FILE = path.join(__dirname, '.fail');
+const ACCESS_TOKEN_TTL_SECONDS = 900;
+
+const USER = {
+  id: 'u_1',
+  email: 'field@example.com',
+  password: 'notes-123',
+  display_name: 'Field Tester',
+};
+
+const NOTES = [
+  { id: 'n_1', title: 'Trailhead parking is full by 8am', days: 1 },
+  { id: 'n_2', title: 'Heron nest spotted near the east bank', days: 3 },
+  { id: 'n_3', title: 'Bridge on loop B is washed out', days: 6 },
+].map(({ days, ...note }) => ({
+  ...note,
+  created_at: new Date(Date.now() - days * 86400000).toISOString(),
+}));
+
+/** access token -> expiry (ms since epoch) */
+const accessTokens = new Map();
+const refreshTokens = new Set();
+
+const newToken = prefix =>
+  `${prefix}_${crypto.randomBytes(16).toString('hex')}`;
+
+function issueSession() {
+  const accessToken = newToken('at');
+  const refreshToken = newToken('rt');
+  accessTokens.set(accessToken, Date.now() + ACCESS_TOKEN_TTL_SECONDS * 1000);
+  refreshTokens.add(refreshToken);
+  return {
+    data: {
+      access_token: accessToken,
+      refresh_token: refreshToken,
+      expires_in: ACCESS_TOKEN_TTL_SECONDS,
+    },
+  };
+}
+
+function bearerToken(req) {
+  const match = /^Bearer (.+)$/.exec(req.headers.authorization ?? '');
+  return match ? match[1] : null;
+}
+
+function isAuthorized(req) {
+  const token = bearerToken(req);
+  const expiresAt = token ? accessTokens.get(token) : undefined;
+  if (expiresAt === undefined) return false;
+  if (expiresAt < Date.now()) {
+    accessTokens.delete(token);
+    return false;
+  }
+  return true;
+}
+
+function send(res, status, body) {
+  if (body === undefined) {
+    res.writeHead(status);
+    return res.end();
+  }
+  res.writeHead(status, { 'Content-Type': 'application/json' });
+  res.end(JSON.stringify(body));
+}
+
+const error = (code, message) => ({ error: { code, message } });
+const unauthorized = res =>
+  send(res, 401, error('unauthorized', 'Missing or expired access token'));
+
+function readJson(req) {
+  return new Promise(resolve => {
+    let raw = '';
+    req.on('data', chunk => {
+      raw += chunk;
+    });
+    req.on('end', () => {
+      try {
+        const parsed = JSON.parse(raw || '{}');
+        resolve(parsed && typeof parsed === 'object' ? parsed : {});
+      } catch {
+        resolve({});
+      }
+    });
+  });
+}
+
+async function handle(req, res) {
+  const url = (req.url ?? '').split('?')[0];
+  const route = `${req.method} ${url}`;
+
+  if (url.startsWith('/api/v1/notes') && fs.existsSync(FAIL_FILE)) {
+    return send(
+      res,
+      503,
+      error('unavailable', 'Notes are temporarily unavailable')
+    );
+  }
+
+  switch (route) {
+    case 'POST /api/v1/sessions': {
+      const { email, password } = await readJson(req);
+      if (email !== USER.email || password !== USER.password) {
+        return send(
+          res,
+          422,
+          error('invalid_credentials', 'Email or password is incorrect')
+        );
+      }
+      return send(res, 201, issueSession());
+    }
+    case 'POST /api/v1/sessions/refresh': {
+      const { refresh_token: refreshToken } = await readJson(req);
+      if (!refreshTokens.has(refreshToken)) {
+        return send(res, 401, error('invalid_token', 'Unknown refresh token'));
+      }
+      // Rotate: a refresh token works once.
+      refreshTokens.delete(refreshToken);
+      return send(res, 200, issueSession());
+    }
+    case 'DELETE /api/v1/sessions': {
+      const token = bearerToken(req);
+      if (token) accessTokens.delete(token);
+      const { refresh_token: refreshToken } = await readJson(req);
+      refreshTokens.delete(refreshToken);
+      return send(res, 204);
+    }
+    case 'GET /api/v1/me':
+      if (!isAuthorized(req)) return unauthorized(res);
+      return send(res, 200, {
+        data: {
+          id: USER.id,
+          email: USER.email,
+          display_name: USER.display_name,
+        },
+      });
+    case 'GET /api/v1/notes':
+      if (!isAuthorized(req)) return unauthorized(res);
+      return send(res, 200, { items: NOTES });
+    default:
+      return send(res, 404, error('not_found', `No route for ${route}`));
+  }
+}
+
+http
+  .createServer((req, res) => {
+    handle(req, res)
+      .then(() =>
+        process.stdout.write(`${req.method} ${req.url} ${res.statusCode}\n`)
+      )
+      .catch(caught => {
+        process.stderr.write(`${req.method} ${req.url} failed: ${caught}\n`);
+        if (!res.headersSent) send(res, 500, error('internal', 'Server error'));
+      });
+  })
+  .listen(port, () => process.stdout.write(`mock backend on :${port}\n`));
