--- /dev/null
+++ b/features/notes/api/notesApi.ts
@@ -0,0 +1,29 @@
+import { z } from 'zod';
+import { api } from '@/shared/http/api';
+import { ApiError } from '@/shared/http/apiError';
+import type { Note } from '../types';
+
+const notesResponse = z.object({
+  items: z.array(
+    z.object({ id: z.string(), title: z.string(), created_at: z.string() })
+  ),
+});
+
+export const notesApi = {
+  /** The signed-in user's notes. Rejects with an ApiError. */
+  list: async (signal?: AbortSignal): Promise<Note[]> => {
+    const { data } = await api.get<unknown>('/api/v1/notes', { signal });
+    const parsed = notesResponse.safeParse(data);
+    if (!parsed.success) {
+      throw new ApiError('The server sent an unexpected response', {
+        code: 'unknown',
+        cause: parsed.error,
+      });
+    }
+    return parsed.data.items.map(item => ({
+      id: item.id,
+      title: item.title,
+      createdAt: item.created_at,
+    }));
+  },
+};
