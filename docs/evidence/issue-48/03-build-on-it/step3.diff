+import { useEffect } from 'react';
+import { FlatList, StyleSheet, View } from 'react-native';
+import { Button, List, Text, useTheme } from 'react-native-paper';
+import { useFetch } from '@/shared/lib/useFetch';
+import { LoadingScreen } from '@/shared/ui/LoadingScreen';
+import { getAnalytics } from '@/shared/integrations/analytics';
+import { getLocale, t } from '@/shared/i18n';
+import { notesApi } from '../api/notesApi';
+
+/** Loads the signed-in user's notes, with loading, error and Retry states. */
+export function NotesList() {
+  const theme = useTheme();
+  const { data, loading, error, refetch } = useFetch(signal =>
+    notesApi.list(signal)
+  );
+
+  useEffect(() => {
+    if (data) getAnalytics().track('notes_loaded', { count: data.length });
+  }, [data]);
+
+  const retry = () => {
+    getAnalytics().track('notes_retry', { error: error?.code ?? null });
+    void refetch();
+  };
+
+  if (loading && !data) return <LoadingScreen message={t('notes.loading')} />;
+
+  if (error) {
+    return (
+      <View style={styles.center}>
+        <Text
+          variant="bodyMedium"
+          style={[styles.message, { color: theme.colors.error }]}
+          testID="notes-error"
+        >
+          {t('notes.error', { message: error.message })}
+        </Text>
+        <Button mode="contained" onPress={retry} testID="notes-retry">
+          {t('notes.retry')}
+        </Button>
+      </View>
+    );
+  }
+
+  return (
+    <FlatList
+      data={data ?? []}
+      keyExtractor={note => note.id}
+      refreshing={loading}
+      onRefresh={() => void refetch()}
+      renderItem={({ item }) => (
+        <List.Item
+          title={item.title}
+          description={new Date(item.createdAt).toLocaleDateString(getLocale())}
+          left={props => <List.Icon {...props} icon="note-text-outline" />}
+        />
+      )}
+      ListEmptyComponent={
+        <Text
+          variant="bodyMedium"
+          style={[styles.message, { color: theme.colors.onSurfaceVariant }]}
+        >
+          {t('notes.empty')}
+        </Text>
+      }
+      testID="notes-list"
+    />
+  );
+}
+
+const styles = StyleSheet.create({
+  center: {
+    flex: 1,
+    justifyContent: 'center',
+    alignItems: 'center',
+    padding: 16,
+  },
+  message: {
+    marginBottom: 16,
+    textAlign: 'center',
+  },
+});
