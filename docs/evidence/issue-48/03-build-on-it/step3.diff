+/**
+ * A fake analytics provider: keeps every call in memory and logs it. Stands
+ * in for a real SDK until one is chosen, and lets tests and debugging see
+ * exactly what the app reported. Registered in shared/integrations/setup.ts.
+ */
+import { logger } from '@/shared/lib/logger';
+import type { Analytics, AnalyticsProperties } from '../analytics';
+
+export type RecordedAnalyticsEvent =
+  | { type: 'track'; name: string; properties: AnalyticsProperties | null }
+  | { type: 'screen'; name: string; properties: AnalyticsProperties | null }
+  | {
+      type: 'identify';
+      userId: string | null;
+      traits: AnalyticsProperties | null;
+    };
+
+export interface MemoryAnalytics extends Analytics {
+  /** Everything recorded so far, oldest first (at most `limit` entries). */
+  readonly events: readonly RecordedAnalyticsEvent[];
+  clear(): void;
+}
+
+/** `limit` caps memory use in a long session; older events are dropped. */
+export function createMemoryAnalytics(limit = 500): MemoryAnalytics {
+  const events: RecordedAnalyticsEvent[] = [];
+  const record = (event: RecordedAnalyticsEvent) => {
+    events.push(event);
+    if (events.length > limit) events.splice(0, events.length - limit);
+    const { type, ...rest } = event;
+    logger.debug(`[analytics:memory] ${type}`, rest);
+  };
+
+  return {
+    events,
+    clear: () => {
+      events.length = 0;
+    },
+    track: (name, properties) =>
+      record({ type: 'track', name, properties: properties ?? null }),
+    screen: (name, properties) =>
+      record({ type: 'screen', name, properties: properties ?? null }),
+    identify: (userId, traits) =>
+      record({ type: 'identify', userId, traits: traits ?? null }),
+  };
+}
