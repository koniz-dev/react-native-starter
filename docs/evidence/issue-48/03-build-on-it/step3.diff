new file mode 100644
index 0000000..2eabb7e
--- /dev/null
+++ b/features/auth/fieldNotesAuthAdapter.ts
@@ -0,0 +1,109 @@
+/**
+ * Sign-in against the Field Notes backend (EXPO_PUBLIC_AUTH_API_URL; the
+ * contract is in mock-backend/server.js). Registered in
+ * shared/integrations/setup.ts.
+ */
+import type { AxiosInstance } from 'axios';
+import { Platform } from 'react-native';
+import { z } from 'zod';
+import type { AuthAdapter } from '@/shared/session/authService';
+import {
+  createMemoryTokenStore,
+  createSecureTokenStore,
+} from '@/shared/session/tokenStore';
+
+/**
+ * Where the refresh token lives: like the access token, in secure storage on
+ * native and in memory on web (see shared/session/tokenStore.ts).
+ */
+export const refreshTokenStore =
+  Platform.OS === 'web'
+    ? createMemoryTokenStore()
+    : createSecureTokenStore('refresh_token');
+
+const sessionResponse = z.object({
+  data: z.object({
+    access_token: z.string().min(1),
+    refresh_token: z.string().min(1),
+  }),
+});
+
+const userEnvelope = z.object({ data: z.unknown() });
+
+const backendUser = z.object({
+  id: z.string().min(1),
+  email: z.string().min(1),
+  display_name: z.string().optional(),
+});
+
+async function requestTokens(
+  http: AxiosInstance,
+  url: string,
+  body: Record<string, string>
+) {
+  const { data } = await http.post<unknown>(url, body);
+  const tokens = sessionResponse.parse(data).data;
+  return { access: tokens.access_token, refresh: tokens.refresh_token };
+}
+
+export const fieldNotesAuthAdapter: AuthAdapter = {
+  // The login form's username field holds the email address.
+  login: async ({ username, password }, { public: http }) => {
+    const tokens = await requestTokens(http, '/api/v1/sessions', {
+      email: username,
+      password,
+    });
+    // The session response has no user. The authenticated client would send
+    // the stored token, which isn't saved until this returns, so pass the new
+    // one explicitly.
+    const { data } = await http.get<unknown>('/api/v1/me', {
+      headers: { Authorization: `Bearer ${tokens.access}` },
+    });
+    await refreshTokenStore.set(tokens.refresh);
+    return { token: tokens.access, user: userEnvelope.parse(data).data };
+  },
+
+  normalizeUser: raw => {
+    const parsed = backendUser.safeParse(raw);
+    if (!parsed.success) {
+      throw new Error('The sign-in response did not include the user');
+    }
+    const user = parsed.data;
+    return {
+      id: user.id,
+      email: user.email,
+      name: user.display_name ?? user.email,
+    };
+  },
+
+  fetchUser: async ({ authenticated }) =>
+    userEnvelope.parse((await authenticated.get<unknown>('/api/v1/me')).data)
+      .data,
+
+  refresh: async ({ public: http }) => {
+    const refreshToken = await refreshTokenStore.get();
+    if (!refreshToken) return null;
+    try {
+      // The backend rotates the refresh token: the old one stops working.
+      const tokens = await requestTokens(http, '/api/v1/sessions/refresh', {
+        refresh_token: refreshToken,
+      });
+      await refreshTokenStore.set(tokens.refresh);
+      return tokens.access;
+    } catch (error) {
+      // A failed refresh signs the user out, so the token is of no further use.
+      await refreshTokenStore.clear();
+      throw error;
+    }
+  },
+
+  logout: async ({ authenticated }) => {
+    const refreshToken = await refreshTokenStore.get();
+    // No refresh token: this adapter didn't start the session; nothing to revoke.
+    if (!refreshToken) return;
+    await refreshTokenStore.clear();
+    await authenticated.delete('/api/v1/sessions', {
+      data: { refresh_token: refreshToken },
+    });
+  },
+};
