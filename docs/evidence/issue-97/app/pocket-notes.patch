+import { act, fireEvent, screen, waitFor } from '@testing-library/react-native';
+import { router } from 'expo-router';
+import { NotesScreen } from '@/features/notes/screens/NotesScreen';
+import { api } from '@/shared/http/api';
+import { setItem, STORAGE_KEYS } from '@/shared/storage/storage';
+import { renderWithProviders, secureStore } from '@/testing';
+import { failure, holdRequests, NOTES, ok } from '@/testing/http';
+
+const originalAdapter = api.defaults.adapter;
+afterEach(() => {
+  api.defaults.adapter = originalAdapter;
+  jest.restoreAllMocks();
+});
+
+async function signIn() {
+  secureStore.set(STORAGE_KEYS.AUTH_TOKEN, 'stored-token');
+  await setItem(STORAGE_KEYS.INSTALL_MARKER, true);
+  await setItem(STORAGE_KEYS.USER_DATA, {
+    id: 'u-1',
+    email: 'a@b.c',
+    name: 'Ada',
+  });
+}
+
+it('asks a signed-out user to sign in, and loads nothing', async () => {
+  const requests = holdRequests();
+  const navigate = jest.spyOn(router, 'navigate').mockImplementation(() => {});
+  renderWithProviders(<NotesScreen />, { withSession: true });
+
+  fireEvent.press(await screen.findByTestId('notes-sign-in'));
+
+  expect(screen.getByText('Sign in to see your notes')).toBeTruthy();
+  expect(navigate).toHaveBeenCalledWith('/login');
+  expect(requests).toHaveLength(0);
+});
+
+it('shows the error with Try again, then the notes, and opens one', async () => {
+  await signIn();
+  const requests = holdRequests();
+  const navigate = jest.spyOn(router, 'navigate').mockImplementation(() => {});
+  renderWithProviders(<NotesScreen />, { withSession: true });
+
+  await waitFor(() => expect(requests).toHaveLength(1));
+  await act(async () => requests[0]?.reject(failure(requests[0].config, 503)));
+  expect(
+    await screen.findByText('The server had a problem. Please try again later.')
+  ).toBeTruthy();
+
+  fireEvent.press(screen.getByText('Try again'));
+  await waitFor(() => expect(requests).toHaveLength(2));
+  await act(async () =>
+    requests[1]?.resolve(ok(requests[1].config, { data: NOTES }))
+  );
+
+  fireEvent.press(await screen.findByText('Groceries'));
+  expect(navigate).toHaveBeenCalledWith('/notes/n1');
+  fireEvent.press(screen.getByTestId('notes-new'));
+  expect(navigate).toHaveBeenCalledWith('/notes/new');
+});
+
+it('says when there are no notes', async () => {
+  await signIn();
+  const requests = holdRequests();
+  renderWithProviders(<NotesScreen />, { withSession: true });
+  await waitFor(() => expect(requests).toHaveLength(1));
+  await act(async () =>
+    requests[0]?.resolve(ok(requests[0].config, { data: [] }))
+  );
+  expect(await screen.findByText('No notes yet')).toBeTruthy();
+});
