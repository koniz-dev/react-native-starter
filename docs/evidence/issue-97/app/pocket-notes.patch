@@ -0,0 +1,43 @@
+import { notesApi } from '@/features/notes/api/notesApi';
+import { api } from '@/shared/http/api';
+import { waitFor } from '@testing-library/react-native';
+import { holdRequests, NOTES, ok } from '@/testing/http';
+
+const originalAdapter = api.defaults.adapter;
+afterEach(() => {
+  api.defaults.adapter = originalAdapter;
+});
+
+it('lists, gets, and creates notes through the { data } envelope', async () => {
+  const requests = holdRequests();
+
+  const list = notesApi.list();
+  await waitFor(() => expect(requests).toHaveLength(1));
+  requests[0]?.resolve(ok(requests[0].config, { data: NOTES }));
+  await expect(list).resolves.toEqual(NOTES);
+
+  const one = notesApi.get('n 1');
+  await waitFor(() => expect(requests).toHaveLength(2));
+  expect(requests[1]?.config.url).toBe('/notes/n%201');
+  requests[1]?.resolve(ok(requests[1].config, { data: NOTES[0] }));
+  await expect(one).resolves.toEqual(NOTES[0]);
+
+  const created = notesApi.create({ title: 'New', body: '' });
+  await waitFor(() => expect(requests).toHaveLength(3));
+  expect(JSON.parse(String(requests[2]?.config.data))).toEqual({
+    title: 'New',
+    body: '',
+  });
+  requests[2]?.resolve(
+    ok(requests[2].config, { data: { ...NOTES[0], title: 'New' } })
+  );
+  await expect(created).resolves.toMatchObject({ title: 'New' });
+});
+
+it('rejects a payload of another shape with a readable message', async () => {
+  const requests = holdRequests();
+  const list = notesApi.list();
+  await waitFor(() => expect(requests).toHaveLength(1));
+  requests[0]?.resolve(ok(requests[0].config, NOTES)); // no envelope
+  await expect(list).rejects.toThrow('Unexpected response from the server');
+});
