+import { router } from 'expo-router';
+import { FlatList, StyleSheet, View } from 'react-native';
+import { SafeAreaView } from 'react-native-safe-area-context';
+import { Button, FAB, List, Text, useTheme } from 'react-native-paper';
+import { t } from '@/shared/i18n';
+import { useFetch } from '@/shared/lib/useFetch';
+import { useSession } from '@/shared/session/SessionProvider';
+import { DocumentTitle } from '@/shared/ui/DocumentTitle';
+import { LoadingScreen } from '@/shared/ui/LoadingScreen';
+import { notesApi } from '../api/notesApi';
+import { LoadError } from '../components/LoadError';
+
+/** The Notes tab: a sign-in prompt, or the user's notes. */
+export function NotesScreen() {
+  const theme = useTheme();
+  const { session } = useSession();
+  if (session.status === 'loading') return <LoadingScreen />;
+  return (
+    <SafeAreaView
+      style={[styles.container, { backgroundColor: theme.colors.background }]}
+    >
+      <DocumentTitle title={t('notes.title')} />
+      <Text
+        variant="headlineMedium"
+        accessibilityRole="header"
+        style={styles.title}
+      >
+        {t('notes.title')}
+      </Text>
+      {session.status === 'signedOut' ? (
+        <View style={styles.prompt}>
+          <Text>{t('notes.signedOut')}</Text>
+          <Button
+            mode="contained"
+            onPress={() => router.navigate('/login')}
+            testID="notes-sign-in"
+          >
+            {t('notes.signIn')}
+          </Button>
+        </View>
+      ) : (
+        <NotesList />
+      )}
+    </SafeAreaView>
+  );
+}
+
+function NotesList() {
+  const { data, loading, error, refetch } = useFetch(signal =>
+    notesApi.list(signal)
+  );
+  if (loading && !data) return <LoadingScreen />;
+  return (
+    <View style={styles.list}>
+      <LoadError
+        error={error}
+        what="Loading notes"
+        onRetry={() => void refetch()}
+      />
+      <FlatList
+        data={data ?? []}
+        keyExtractor={note => note.id}
+        refreshing={loading}
+        onRefresh={() => void refetch()}
+        ListEmptyComponent={
+          data ? <Text style={styles.empty}>{t('notes.empty')}</Text> : null
+        }
+        renderItem={({ item }) => (
+          <List.Item
+            title={item.title}
+            description={item.body}
+            descriptionNumberOfLines={1}
+            accessibilityRole="button"
+            onPress={() => router.navigate(`/notes/${item.id}`)}
+            testID={`note-${item.id}`}
+          />
+        )}
+      />
+      <FAB
+        icon="plus"
+        label={t('notes.new')}
+        accessibilityLabel={t('notes.new')}
+        style={styles.fab}
+        onPress={() => router.navigate('/notes/new')}
+        testID="notes-new"
+      />
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  container: { flex: 1, paddingHorizontal: 16 },
+  title: { marginVertical: 16 },
+  prompt: { flex: 1, alignItems: 'center', justifyContent: 'center', gap: 16 },
+  list: { flex: 1, width: '100%', maxWidth: 720, alignSelf: 'center' },
+  empty: { paddingVertical: 24, textAlign: 'center' },
+  fab: { position: 'absolute', end: 0, bottom: 16 },
+});
