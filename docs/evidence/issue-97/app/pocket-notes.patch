--- /dev/null
+++ b/features/auth/api/avatarApi.ts
@@ -0,0 +1,47 @@
+import { z } from 'zod';
+import { getConfig } from '@/shared/config/env';
+import { api, getOrigin } from '@/shared/http/api';
+import { unwrap } from '@/shared/http/envelope';
+
+const AvatarSchema = z.object({ avatar_url: z.string().nullable() });
+
+/**
+ * An absolute URL for a root-relative path the API returns, such as
+ * `/avatars/1` (React Native's URL can't resolve a relative URL).
+ */
+function absolute(path: string | null): string | null {
+  return path ? `${getOrigin(getConfig().apiUrl) ?? ''}${path}` : null;
+}
+
+export interface PickedImage {
+  uri: string;
+  name: string;
+  type: string;
+  /** On the web, the picked file itself. */
+  file?: Blob;
+}
+
+export const avatarApi = {
+  /** The signed-in user's avatar URL, or null. */
+  get: async (signal?: AbortSignal): Promise<string | null> =>
+    absolute(
+      unwrap(AvatarSchema, (await api.get('/me', { signal })).data).avatar_url
+    ),
+  /** Uploads a picked image as multipart; returns the new avatar URL. */
+  upload: async (image: PickedImage): Promise<string | null> => {
+    const form = new FormData();
+    if (image.file) {
+      form.append('avatar', image.file, image.name);
+    } else {
+      // React Native reads the file at `uri`; the cast is for the DOM typings.
+      form.append('avatar', {
+        uri: image.uri,
+        name: image.name,
+        type: image.type,
+      } as unknown as Blob);
+    }
+    return absolute(
+      unwrap(AvatarSchema, (await api.post('/me/avatar', form)).data).avatar_url
+    );
+  },
+};
