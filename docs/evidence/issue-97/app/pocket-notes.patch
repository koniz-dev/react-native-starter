+import { logger } from '@/shared/lib/logger';
+import type { PostHogClient } from './posthog';
+
+/**
+ * Stands in for `new PostHog(key)` until the app has a PostHog project: it
+ * logs what would be sent.
+ */
+export const devPostHog: PostHogClient = {
+  capture: (event, properties) =>
+    logger.info(`[posthog] capture ${event}`, properties ?? null),
+  screen: name => logger.info(`[posthog] screen ${name}`),
+  identify: id => logger.info(`[posthog] identify ${id}`),
+  reset: () => logger.info('[posthog] reset'),
+};
diff --git a/shared/integrations/adapters/posthog.ts b/shared/integrations/adapters/posthog.ts
new file mode 100644
index 0000000..67b4ff9
--- /dev/null
+++ b/shared/integrations/adapters/posthog.ts
@@ -0,0 +1,18 @@
+import type { Analytics } from '@/shared/integrations/analytics';
+
+/** The part of a PostHog client (posthog-react-native) this adapter uses. */
+export interface PostHogClient {
+  capture(event: string, properties?: Record<string, unknown>): void;
+  screen(name: string, properties?: Record<string, unknown>): void;
+  identify(distinctId: string, properties?: Record<string, unknown>): void;
+  reset(): void;
+}
+
+export function createPostHogAnalytics(client: PostHogClient): Analytics {
+  return {
+    track: (event, properties) => client.capture(event, properties),
+    screen: (name, properties) => client.screen(name, properties),
+    identify: (userId, traits) =>
+      userId ? client.identify(userId, traits) : client.reset(),
+  };
+}
