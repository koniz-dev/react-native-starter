index 0000000..941691a
--- /dev/null
+++ b/__tests__/features/auth/AvatarPicker.test.tsx
@@ -0,0 +1,135 @@
+import { act, fireEvent, screen, waitFor } from '@testing-library/react-native';
+import { AxiosError } from 'axios';
+import * as ImagePicker from 'expo-image-picker';
+import { AvatarPicker } from '@/features/auth/components/AvatarPicker';
+import { api } from '@/shared/http/api';
+import { logger } from '@/shared/lib/logger';
+import { renderWithProviders } from '@/testing';
+import { failure, holdRequests, ok } from '@/testing/http';
+
+jest.mock('expo-image-picker', () => ({
+  launchImageLibraryAsync: jest.fn(),
+}));
+
+const picked = {
+  canceled: false,
+  assets: [
+    { uri: 'file:///photo.jpg', fileName: 'photo.jpg', mimeType: 'image/jpeg' },
+  ],
+};
+
+const originalAdapter = api.defaults.adapter;
+afterEach(() => {
+  api.defaults.adapter = originalAdapter;
+  jest.restoreAllMocks();
+});
+
+it('loads the photo, uploads a picked one as multipart, and shows it', async () => {
+  jest
+    .mocked(ImagePicker.launchImageLibraryAsync)
+    .mockResolvedValue(picked as never);
+  const requests = holdRequests();
+  renderWithProviders(<AvatarPicker />);
+  await waitFor(() => expect(requests).toHaveLength(1));
+  await act(async () =>
+    requests[0]?.resolve(
+      ok(requests[0].config, { data: { avatar_url: '/avatars/1' } })
+    )
+  );
+  expect(screen.getByTestId('avatar-image').props.source).toEqual({
+    uri: 'https://api.example.com/avatars/1',
+  });
+
+  fireEvent.press(screen.getByTestId('avatar-change'));
+  await waitFor(() => expect(requests).toHaveLength(2));
+  const upload = requests[1]!;
+  expect(upload.config.url).toBe('/me/avatar');
+  expect(upload.config.data).toBeInstanceOf(FormData);
+  expect(String(upload.config.headers['Content-Type'])).toBe(
+    'multipart/form-data'
+  );
+  await act(async () =>
+    upload.resolve(ok(upload.config, { data: { avatar_url: '/avatars/2' } }))
+  );
+  expect(await screen.findByText('Photo updated')).toBeTruthy();
+  expect(screen.getByTestId('avatar-image').props.source).toEqual({
+    uri: 'https://api.example.com/avatars/2',
+  });
+});
+
+it('does nothing when the picker is canceled', async () => {
+  jest
+    .mocked(ImagePicker.launchImageLibraryAsync)
+    .mockResolvedValue({ canceled: true, assets: null } as never);
+  const requests = holdRequests();
+  renderWithProviders(<AvatarPicker />);
+  await waitFor(() => expect(requests).toHaveLength(1));
+  await act(async () =>
+    requests[0]?.resolve(ok(requests[0].config, { data: { avatar_url: null } }))
+  );
+  fireEvent.press(screen.getByTestId('avatar-change'));
+  await act(async () => {});
+  expect(requests).toHaveLength(1);
+});
+
+it("shows the server's message for a rejected photo, and logs an unexpected answer", async () => {
+  jest
+    .mocked(ImagePicker.launchImageLibraryAsync)
+    .mockResolvedValue(picked as never);
+  const logError = jest.spyOn(logger, 'error').mockImplementation(() => {});
+  const requests = holdRequests();
+  renderWithProviders(<AvatarPicker />);
+  await waitFor(() => expect(requests).toHaveLength(1));
+  await act(async () =>
+    requests[0]?.resolve(ok(requests[0].config, { data: { avatar_url: null } }))
+  );
+
+  fireEvent.press(screen.getByTestId('avatar-change'));
+  await waitFor(() => expect(requests).toHaveLength(2));
+  await act(async () =>
+    requests[1]?.reject(
+      failure(requests[1].config, 422, { error: { message: 'Send an image' } })
+    )
+  );
+  expect(await screen.findByText('Send an image')).toBeTruthy();
+
+  fireEvent.press(screen.getByTestId('avatar-change'));
+  await waitFor(() => expect(requests).toHaveLength(3));
+  await act(async () =>
+    requests[2]?.resolve(ok(requests[2].config, { data: {} }))
+  );
+  expect(
+    await screen.findByText('Something went wrong. Please try again.')
+  ).toBeTruthy();
+  expect(logError).toHaveBeenCalledWith(
+    'Uploading the profile photo failed',
+    expect.anything()
+  );
+});
+
+it('tries an upload once more after a network error', async () => {
+  jest
+    .mocked(ImagePicker.launchImageLibraryAsync)
+    .mockResolvedValue(picked as never);
+  const requests = holdRequests();
+  renderWithProviders(<AvatarPicker />);
+  await waitFor(() => expect(requests).toHaveLength(1));
+  await act(async () =>
+    requests[0]?.resolve(ok(requests[0].config, { data: { avatar_url: null } }))
+  );
+
+  fireEvent.press(screen.getByTestId('avatar-change'));
+  await waitFor(() => expect(requests).toHaveLength(2));
+  await act(async () =>
+    requests[1]?.reject(
+      new AxiosError('Network Error', 'ERR_NETWORK', requests[1].config)
+    )
+  );
+  await waitFor(() => expect(requests).toHaveLength(3));
+  await act(async () =>
+    requests[2]?.resolve(
+      ok(requests[2].config, { data: { avatar_url: '/avatars/9' } })
+    )
+  );
+  expect(await screen.findByText('Photo updated')).toBeTruthy();
+});
