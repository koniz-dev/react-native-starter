@@ -0,0 +1,96 @@
+import { useState } from 'react';
+import { Platform, StyleSheet, View } from 'react-native';
+import * as ImagePicker from 'expo-image-picker';
+import { Avatar, Button, HelperText } from 'react-native-paper';
+import { toApiError } from '@/shared/http/apiError';
+import { errorMessage } from '@/shared/http/errorMessage';
+import { t } from '@/shared/i18n';
+import { logger } from '@/shared/lib/logger';
+import { useFetch } from '@/shared/lib/useFetch';
+import { useAnnouncement } from '@/shared/ui/useAnnouncement';
+import { avatarApi } from '../api/avatarApi';
+
+/** The user's photo, and a button to pick and upload a new one. */
+export function AvatarPicker() {
+  const { data } = useFetch(signal => avatarApi.get(signal));
+  // The uploaded photo replaces the loaded one.
+  const [uploaded, setUploaded] = useState<string | null>(null);
+  const url = uploaded ?? data;
+  const [uploading, setUploading] = useState(false);
+  const [message, setMessage] = useState<string | null>(null);
+  useAnnouncement(message);
+
+  const pick = async () => {
+    const result = await ImagePicker.launchImageLibraryAsync({
+      mediaTypes: ['images'],
+      quality: 0.8,
+    });
+    const asset = result.canceled ? undefined : result.assets[0];
+    if (!asset) return;
+    setUploading(true);
+    setMessage(null);
+    try {
+      const image = {
+        uri: asset.uri,
+        name: asset.fileName ?? 'avatar.jpg',
+        type: asset.mimeType ?? 'image/jpeg',
+        file: Platform.OS === 'web' ? (asset.file ?? undefined) : undefined,
+      };
+      // On Android (seen in Expo Go), an upload sent the moment the picker
+      // closes can fail with a network error; a second try goes through.
+      const newUrl = await avatarApi.upload(image).catch((error: unknown) => {
+        if (toApiError(error).code !== 'network') throw error;
+        return avatarApi.upload(image);
+      });
+      setUploaded(newUrl);
+      setMessage(t('profile.photoUpdated'));
+    } catch (caught) {
+      if (toApiError(caught).code === 'unknown') {
+        logger.error('Uploading the profile photo failed', caught);
+      }
+      setMessage(errorMessage(caught));
+    } finally {
+      setUploading(false);
+    }
+  };
+
+  return (
+    <View style={styles.container}>
+      {url ? (
+        <Avatar.Image
+          size={72}
+          source={{ uri: url }}
+          accessibilityLabel={t('profile.photo')}
+          testID="avatar-image"
+        />
+      ) : (
+        <Avatar.Icon
+          size={72}
+          icon="account"
+          accessibilityLabel={t('profile.photo')}
+        />
+      )}
+      <Button
+        mode="outlined"
+        onPress={() => void pick()}
+        loading={uploading}
+        disabled={uploading}
+        testID="avatar-change"
+      >
+        {t('profile.changePhoto')}
+      </Button>
+      <HelperText
+        type="info"
+        visible={message !== null}
+        accessibilityLiveRegion="polite"
+        testID="avatar-message"
+      >
+        {message ?? ''}
+      </HelperText>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  container: { alignItems: 'center', gap: 8, paddingVertical: 8 },
+});
