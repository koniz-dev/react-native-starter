+        try {
+          return JSON.parse(body.toString() || '{}');
+        } catch {
+          return {};
+        }
+      };
+      const log = status =>
+        console.log(
+          `${new Date().toISOString()} ${req.method} ${path} ${status} auth=${authed(req)}`
+        );
+      if (req.method === 'OPTIONS') return send(res, 204, '');
