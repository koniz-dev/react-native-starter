+export function unwrap<T>(schema: z.ZodType<T>, body: unknown): T {
+  const result = z.object({ data: schema }).safeParse(body);
+  if (!result.success) {
+    throw new Error('Unexpected response from the server', {
+      cause: result.error,
+    });
+  }
+  return result.data.data;
+}
