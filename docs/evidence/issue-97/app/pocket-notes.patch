--- /dev/null
+++ b/features/notes/api/notesApi.ts
@@ -0,0 +1,29 @@
+import { z } from 'zod';
+import { api } from '@/shared/http/api';
+import { unwrap } from '@/shared/http/envelope';
+
+const NoteSchema = z.object({
+  id: z.string(),
+  title: z.string(),
+  body: z.string(),
+  updated_at: z.string(),
+});
+
+export type Note = z.infer<typeof NoteSchema>;
+
+export interface NewNote {
+  title: string;
+  body: string;
+}
+
+export const notesApi = {
+  list: async (signal?: AbortSignal): Promise<Note[]> =>
+    unwrap(z.array(NoteSchema), (await api.get('/notes', { signal })).data),
+  get: async (id: string, signal?: AbortSignal): Promise<Note> =>
+    unwrap(
+      NoteSchema,
+      (await api.get(`/notes/${encodeURIComponent(id)}`, { signal })).data
+    ),
+  create: async (note: NewNote): Promise<Note> =>
+    unwrap(NoteSchema, (await api.post('/notes', note)).data),
+};
