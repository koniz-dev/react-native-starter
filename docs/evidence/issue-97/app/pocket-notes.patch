--- /dev/null
+++ b/features/notes/components/LoadError.tsx
@@ -0,0 +1,48 @@
+import { useEffect } from 'react';
+import { StyleSheet, View } from 'react-native';
+import { Button, Text, useTheme } from 'react-native-paper';
+import type { ApiError } from '@/shared/http/apiError';
+import { errorMessage } from '@/shared/http/errorMessage';
+import { t } from '@/shared/i18n';
+import { logger } from '@/shared/lib/logger';
+import { useAnnouncement } from '@/shared/ui/useAnnouncement';
+
+/**
+ * A failed load, said in words the user can act on, with Try again. Stays
+ * mounted (an empty live region) so a new error is announced.
+ */
+export function LoadError({
+  error,
+  what,
+  onRetry,
+}: {
+  error: ApiError | null;
+  /** For the log, e.g. "Loading notes". */
+  what: string;
+  onRetry: () => void;
+}) {
+  const theme = useTheme();
+  const message = error && errorMessage(error);
+  useAnnouncement(message);
+  useEffect(() => {
+    // Not a server answer (e.g. a payload that fails the schema).
+    if (error?.code === 'unknown') logger.error(`${what} failed`, error);
+  }, [error, what]);
+
+  return (
+    <View accessibilityLiveRegion="polite" testID="load-error">
+      {message && (
+        <View style={styles.box}>
+          <Text style={{ color: theme.colors.error }}>{message}</Text>
+          <Button mode="outlined" onPress={onRetry} testID="load-retry">
+            {t('common.tryAgain')}
+          </Button>
+        </View>
+      )}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  box: { gap: 12, paddingVertical: 16 },
+});
