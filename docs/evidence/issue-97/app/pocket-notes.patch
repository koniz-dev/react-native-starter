@@ -0,0 +1,107 @@
+import { useRef, useState } from 'react';
+import { router } from 'expo-router';
+import { ScrollView, StyleSheet } from 'react-native';
+import { SafeAreaView } from 'react-native-safe-area-context';
+import { Button, HelperText, TextInput, useTheme } from 'react-native-paper';
+import { toApiError } from '@/shared/http/apiError';
+import { errorMessage } from '@/shared/http/errorMessage';
+import { t } from '@/shared/i18n';
+import { getAnalytics } from '@/shared/integrations/analytics';
+import { logger } from '@/shared/lib/logger';
+import { DocumentTitle } from '@/shared/ui/DocumentTitle';
+import { useAnnouncement } from '@/shared/ui/useAnnouncement';
+import { notesApi } from '../api/notesApi';
+
+export function NewNoteScreen() {
+  const theme = useTheme();
+  const [title, setTitle] = useState('');
+  const [body, setBody] = useState('');
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const savingRef = useRef(false);
+  useAnnouncement(error);
+
+  const save = async () => {
+    if (savingRef.current) return;
+    if (!title.trim()) {
+      setError(t('notes.titleRequired'));
+      return;
+    }
+    savingRef.current = true;
+    setSaving(true);
+    setError(null);
+    try {
+      const note = await notesApi.create({ title, body });
+      getAnalytics().track('note_created');
+      router.replace(`/notes/${note.id}`);
+    } catch (caught) {
+      if (toApiError(caught).code === 'unknown') {
+        logger.error('Saving a note failed', caught);
+      }
+      setError(errorMessage(caught));
+    } finally {
+      savingRef.current = false;
+      setSaving(false);
+    }
+  };
+
+  return (
+    <SafeAreaView
+      edges={['bottom', 'left', 'right']}
+      style={[styles.container, { backgroundColor: theme.colors.background }]}
