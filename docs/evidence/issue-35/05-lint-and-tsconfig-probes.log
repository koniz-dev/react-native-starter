# Probe: a component with an 'any', a missing effect dependency, an inline style, and a color literal; eslint must fail with errors (not warnings)
import { useEffect, useState } from 'react';
import { View } from 'react-native';

export function Probe({ id }: { id: number }) {
  const [value, setValue] = useState<any>(null);
  useEffect(() => {
    setValue(id);
  }, []);
  return <View style={{ backgroundColor: '#ff0000' }}>{value}</View>;
}


