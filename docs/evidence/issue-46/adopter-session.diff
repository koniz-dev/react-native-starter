+import { ScrollView, StyleSheet } from 'react-native';
+import { SafeAreaView } from 'react-native-safe-area-context';
+import { List, Switch, Text, useTheme } from 'react-native-paper';
+import { useThemePreference } from '@/shared/ui/ThemePreference';
+import { t } from '@/shared/i18n';
+
+/** Settings: app preferences, such as light or dark mode. */
+export function SettingsScreen() {
+  const theme = useTheme();
+  const { colorScheme, setPreference } = useThemePreference();
+  const darkMode = colorScheme === 'dark';
+
+  return (
+    <SafeAreaView
+      style={[styles.container, { backgroundColor: theme.colors.background }]}
+    >
+      <ScrollView contentContainerStyle={styles.content}>
+        <Text variant="headlineMedium" style={styles.title}>
+          {t('settings.title')}
+        </Text>
+        <List.Item
+          title={t('settings.darkMode')}
+          left={props => <List.Icon {...props} icon="weather-night" />}
+          right={() => (
+            <Switch
+              value={darkMode}
+              onValueChange={on => setPreference(on ? 'dark' : 'light')}
+              accessibilityLabel={t('settings.darkMode')}
+              testID="settings-dark-mode"
+            />
+          )}
+          onPress={() => setPreference(darkMode ? 'light' : 'dark')}
+        />
+      </ScrollView>
+    </SafeAreaView>
+  );
+}
+
+const styles = StyleSheet.create({
+  container: {
+    flex: 1,
+  },
+  content: {
+    padding: 16,
+  },
+  title: {
+    marginBottom: 8,
+  },
+});
