@@ -0,0 +1,93 @@
+import { StatusBar } from 'expo-status-bar';
+import { fireEvent, renderRouter, screen } from 'expo-router/testing-library';
+import AsyncStorage from '@react-native-async-storage/async-storage';
+import * as loggerModule from '@/shared/lib/logger';
+import { getItem, setItem, STORAGE_KEYS } from '@/shared/storage/storage';
+import { setColorScheme } from '@/testing';
+
+// The status bar style is the app-wide signal of the active theme: 'light'
+// icons on the dark theme, 'dark' icons on the light theme.
+function statusBarStyle() {
+  return screen.UNSAFE_getByType(StatusBar).props.style;
+}
+
+async function openSettings() {
+  renderRouter('./app', { initialUrl: '/settings' });
+  return screen.findByTestId('settings-dark-mode');
+}
+
+describe('Settings dark mode', () => {
+  afterEach(() => jest.restoreAllMocks());
+
+  test('follows the system scheme until the user chooses', async () => {
+    setColorScheme('dark');
+    const toggle = await openSettings();
+
+    expect(toggle.props.value).toBe(true);
+    expect(statusBarStyle()).toBe('light');
+  });
+
+  test('turning it on switches the app to dark and saves the choice', async () => {
+    const toggle = await openSettings();
+    expect(toggle.props.value).toBe(false);
+
+    fireEvent(toggle, 'valueChange', true);
+
+    expect(screen.getByTestId('settings-dark-mode').props.value).toBe(true);
+    expect(statusBarStyle()).toBe('light');
+    await expect(getItem(STORAGE_KEYS.THEME_PREFERENCE)).resolves.toBe('dark');
+  });
+
+  test('tapping the row toggles it too', async () => {
+    await openSettings();
+
+    fireEvent.press(screen.getByText('Dark mode'));
+
+    expect(screen.getByTestId('settings-dark-mode').props.value).toBe(true);
+    expect(statusBarStyle()).toBe('light');
+  });
+
+  test('turning it off overrides a dark system scheme', async () => {
+    setColorScheme('dark');
+    const toggle = await openSettings();
+
+    fireEvent(toggle, 'valueChange', false);
+
+    expect(statusBarStyle()).toBe('dark');
+    await expect(getItem(STORAGE_KEYS.THEME_PREFERENCE)).resolves.toBe('light');
+  });
+
+  test('restores the saved choice on launch', async () => {
+    await setItem(STORAGE_KEYS.THEME_PREFERENCE, 'dark');
+    const toggle = await openSettings();
+
+    expect(toggle.props.value).toBe(true);
+    expect(statusBarStyle()).toBe('light');
+  });
+
+  test('ignores an unrecognized saved value and follows the system', async () => {
+    await setItem(STORAGE_KEYS.THEME_PREFERENCE, 'purple');
+    const toggle = await openSettings();
+
+    expect(toggle.props.value).toBe(false);
+    expect(statusBarStyle()).toBe('dark');
+  });
+
+  test('keeps the choice for this run when it cannot be saved', async () => {
+    const failure = new Error('disk full');
+    jest.mocked(AsyncStorage.setItem).mockRejectedValueOnce(failure);
+    const logError = jest
+      .spyOn(loggerModule.logger, 'error')
+      .mockImplementation(() => {});
+    const toggle = await openSettings();
+
+    fireEvent(toggle, 'valueChange', true);
+
+    expect(statusBarStyle()).toBe('light');
+    await screen.findByTestId('settings-dark-mode');
+    expect(logError).toHaveBeenCalledWith(
+      'Failed to save the theme preference',
+      failure
+    );
+  });
+});
