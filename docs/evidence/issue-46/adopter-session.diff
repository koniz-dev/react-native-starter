+# The Settings switch turns dark mode on, the choice survives a relaunch, and
+# the switch turns it off again.
+appId: ${APP_ID}
+name: Settings dark mode
+---
+- runFlow:
+    file: subflows/open-app.yaml
+    env:
+      CLEAR_STATE: 'true'
+- tapOn:
+    id: tab-settings
+- assertVisible:
+    id: settings-dark-mode
+    checked: false
+- tapOn:
+    id: settings-dark-mode
+- assertVisible:
+    id: settings-dark-mode
+    checked: true
+- takeScreenshot: 07-settings-dark
+- runFlow:
+    file: subflows/open-app.yaml
+    env:
+      CLEAR_STATE: 'false'
+- tapOn:
+    id: tab-settings
+- assertVisible:
+    id: settings-dark-mode
+    checked: true
+- tapOn:
+    id: settings-dark-mode
+- assertVisible:
+    id: settings-dark-mode
+    checked: false
+# A saved choice would override the device's dark mode in dark-mode.yaml.
+- clearState
