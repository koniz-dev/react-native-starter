$ cat .maestro/config.yaml .maestro/dark-mode.yaml
# Maestro workspace config: the numbered flows run in order; the dark-mode
# flow runs separately (scripts/e2e/run.sh switches the device to dark mode).
flows:
  - '*.yaml'
executionOrder:
  continueOnFailure: false
  flowsOrder:
    - Cold start opens Home
    - Back from Login returns Home
excludeTags:
  - dark
# Run with the device in dark mode (scripts/e2e/run.sh switches it): the tab
# bar and status bar follow the dark theme. Screenshots only.
appId: ${APP_ID}
name: Dark mode screenshots
tags:
  - dark
---
- runFlow:
    file: subflows/open-app.yaml
    env:
      CLEAR_STATE: 'false'
- takeScreenshot: dark-home

$ sed -n 60,72p scripts/e2e/run.sh
node "$ROOT/scripts/e2e/mock-api.js" "$MOCK_PORT" >"$OUT/mock-api.log" 2>&1 &
PIDS+=($!)

# The flows don't sign in, so the mock stands in for the auth backend. For
# sign-in flows, set E2E_AUTH_API_URL to your backend and use a test account.
AUTH_ENV=(EXPO_PUBLIC_USE_DEMO_BACKENDS=false
  "EXPO_PUBLIC_AUTH_API_URL=${E2E_AUTH_API_URL:-http://localhost:$MOCK_PORT}")
(
  cd "$ROOT"
  env "${AUTH_ENV[@]}" EXPO_PUBLIC_API_URL="http://localhost:$MOCK_PORT" \
    npx expo start --port "$METRO_PORT" --clear >"$OUT/metro.log" 2>&1
) &
PIDS+=($!)
