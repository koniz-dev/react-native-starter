{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": [],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "exclude": [
    "node_modules",
    "**/node_modules",
    "android",
    "ios",
    "dist",
    "web-build",
    "coverage",
    "e2e-results",
    ".docs-check",
    "__tests__",
    "testing",
    "jest.setup.ts",
    "app.config.ts"
  ]
}
