# Copy to .env and adjust. See docs/environment-variables.md.

# Use the public demo backends (JSONPlaceholder + DummyJSON, demo login
# emilys / emilyspass) for any URL left empty. Set to false (or remove) in real
# builds so a missing URL shows the configuration error screen.
EXPO_PUBLIC_USE_DEMO_BACKENDS=true

# Your API and auth backends. Required when demo backends are off; must be
# https outside development.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_AUTH_API_URL=

# Origins (comma-separated) that may receive the auth token besides the auth
# backend itself, e.g. your API on a separate first-party domain. Leave empty
# for the demo: JSONPlaceholder is an unrelated third party.
EXPO_PUBLIC_API_TRUSTED_ORIGINS=

# Request timeout in milliseconds (1000-120000). Defaults to 15000.
# EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Minimum console log level: debug, info, warn, error, or silent.
# Default: debug in development, info in preview, warn in production.
# Errors reach the error reporter at every level (docs/error-reporting.md).
# EXPO_PUBLIC_LOG_LEVEL=debug

# development | preview | production. Defaults to development in dev builds
# and production otherwise.
# EXPO_PUBLIC_APP_ENV=development
