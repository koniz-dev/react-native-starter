# API Configuration
# Copy this file to .env and update with your values
EXPO_PUBLIC_API_URL=https://jsonplaceholder.typicode.com
# Authentication demo API. It uses username "emilys" and password "emilyspass".
EXPO_PUBLIC_AUTH_API_URL=https://dummyjson.com
# Origins (comma-separated) that may receive the auth token besides the auth API
# itself, e.g. your API on a separate first-party domain. Leave empty for the demo:
# JSONPlaceholder is an unrelated third party and must not receive the token.
EXPO_PUBLIC_API_TRUSTED_ORIGINS=
